{
  "name": "screenshotchecker",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:metadata": "node --experimental-strip-types --test src/lib/utils/__tests__/metadataRenderer.test.mjs",
    "test:reports": "node --experimental-strip-types --test src/lib/utils/__tests__/reportSafety.test.mjs src/lib/utils/__tests__/workspaceSafety.test.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run test && npm run build",
    "test:ocr": "tsx --test src/lib/analyzer/__tests__/ocrCoordinates.test.ts",
    "test:blog-seo": "node --import tsx scripts/verify-blog-seo.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@contentauth/c2pa-web": "^0.14.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.8",
    "exifreader": "^4.44.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tsx": "4.23.15",
    "wrangler": "^4.136.2"
  },
  "packageManager": "npm@11.19.1"
}
