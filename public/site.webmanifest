{
  "id": "/",
  "name": "ScreenshotChecker",
  "short_name": "ScreenshotChecker",
  "description": "Check if a screenshot is real, edited or a scam. Processed privately in your browser.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "theme_color": "#faf9f5",
  "background_color": "#faf9f5",
  "display": "standalone",
  "categories": ["utilities", "security", "productivity"],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "image",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/gif", ".png", ".jpg", ".jpeg", ".webp", ".gif"]
        }
      ]
    }
  }
}
