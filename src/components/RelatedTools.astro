---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const tools = [
  { title: 'Screenshot Analyzer', href: '/screenshot-analyzer', action: 'Analyze your screenshot', desc: 'Central multi-vector image and screenshot safety audit' },
  { title: 'Privacy & PII Checker', href: '/screenshot-privacy-checker', action: 'Audit screenshot privacy', desc: 'Scan exposed emails, phones, payment cards, and credentials' },
  { title: 'Screenshot Redactor', href: '/screenshot-redactor', action: 'Mask sensitive details', desc: 'Blur, pixelate, or black out sensitive sections directly' },
  { title: 'Metadata & EXIF Inspector', href: '/screenshot-metadata-checker', action: 'Inspect image metadata', desc: 'Examine GPS, camera device, timestamps, and editor software' },
  { title: 'Image Metadata Remover', href: '/image-metadata-remover', action: 'Remove metadata from photos', desc: 'One-click client-side EXIF and GPS stripper' },
  { title: 'Screenshot OCR Extractor', href: '/screenshot-ocr', action: 'Extract text from screenshots', desc: 'Extract and copy text from screenshots with zero server lag' },
  { title: 'Scam & Fraud Checker', href: '/screenshot-scam-checker', action: 'Check a suspicious message', desc: 'Identify fake urgency, legal threats, and OTP phishing signals' },
  { title: 'Spam Text Analyzer', href: '/screenshot-spam-checker', action: 'Inspect promotional spam', desc: 'Detect promotional spam phrasing and aggressive marketing CTAs' },
  { title: 'Suspicious Link Checker', href: '/suspicious-link-checker', action: 'Analyze links in screenshots', desc: 'Audit visible URLs, unencrypted HTTP, and Punycode spoofing' },
  { title: 'Image Manipulation Checker', href: '/image-manipulation-checker', action: 'Inspect image manipulation', desc: 'Error Level Analysis (ELA) and compression gradient forensics' },
  { title: 'AI Image Signal Review', href: '/ai-image-detector', action: 'Detect possible AI-generated images', desc: 'Evaluate synthetic imagery artifacts with honest limitations' },
  { title: 'Screenshot Comparison', href: '/screenshot-comparison', action: 'Compare screenshot versions', desc: 'Side-by-side visual difference and region comparison' },
  { title: 'Payment Screenshot Review', href: '/payment-screenshot-checker', action: 'Review payment screenshots', desc: 'Review receipt and invoice layout consistency signals' },
];

const filteredTools = tools.filter((t) => t.href !== currentPath);
---

<section class="py-16 max-w-6xl mx-auto px-4 sm:px-6">
  <div class="mb-10 text-center sm:text-left">
    <span class="text-xs uppercase tracking-wider font-semibold text-primary">Tool Ecosystem</span>
    <h2 class="font-serif text-2xl sm:text-3xl text-ink font-normal mt-1">
      Tools for Screenshot & Image Investigation
    </h2>
    <p class="text-sm text-muted mt-1.5 max-w-2xl">
      Explore dedicated browser tools for verifying screenshots, detecting fraud signals, inspecting EXIF metadata, and extracting text.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {filteredTools.map((tool) => (
      <a
        href={tool.href}
        class="feature-card !p-5 group hover:border-primary/40 hover:bg-surface-cream-strong/50 transition-all flex flex-col justify-between"
      >
        <div>
          <h3 class="font-serif text-base text-ink font-normal group-hover:text-primary transition-colors mb-1.5 flex items-center justify-between">
            <span>{tool.title}</span>
            <svg class="w-4 h-4 text-muted group-hover:text-primary transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </h3>
          <p class="text-xs text-body leading-relaxed mb-3">{tool.desc}</p>
        </div>
        <div class="pt-2 border-t border-hairline/60 flex items-center justify-between text-[11px] font-mono text-primary font-medium">
          <span>{tool.action}</span>
          <span>→</span>
        </div>
      </a>
    ))}
  </div>
</section>
