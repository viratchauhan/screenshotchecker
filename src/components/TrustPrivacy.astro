---
---

<section class="py-16 max-w-6xl mx-auto px-4 sm:px-6">
  <div class="product-mockup-dark p-8 sm:p-12 relative overflow-hidden">
    <div class="relative z-10 max-w-2xl space-y-4">
      <span class="badge-coral text-xs">Privacy By Design</span>
      <h2 class="font-serif text-3xl sm:text-4xl text-on-dark font-normal tracking-tight">
        Zero Data Leaves Your Device
      </h2>
      <p class="text-sm sm:text-base text-on-dark-soft leading-relaxed">
        Many online image tools upload your personal screenshots to remote cloud servers for processing. Screenshot Checker runs entirely inside your browser sandbox. We never store, transmit, or inspect your images.
      </p>
      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a href="/privacy" class="btn-secondary-dark text-xs sm:text-sm">
          <span>Read Privacy Architecture</span>
          <svg class="w-4 h-4 text-accent-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="#uploader-section" class="text-xs text-on-dark hover:underline flex items-center gap-1 font-medium">
          <span>Start local scan</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
        </a>
      </div>
    </div>

    <!-- Decorative background elements -->
    <div class="absolute -right-16 -bottom-16 w-80 h-80 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
  </div>
</section>
