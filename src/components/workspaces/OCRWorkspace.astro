---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import FaqSection from '../FaqSection.astro';
import RelatedLinks from '../RelatedLinks.astro';
import { getToolFaqs } from '../../data/toolFaqs';

const faqs = getToolFaqs('screenshot-ocr');
---

<div class="min-h-screen flex flex-col bg-canvas text-body">
  <Header currentPath="/screenshot-ocr" />

  <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 w-full">
    <!-- Workspace Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="badge-pill !text-xs font-mono font-semibold">OCR Workspace</span>
          <span class="text-xs text-muted">Advanced Image Preprocessing + Tesseract OCR</span>
        </div>
        <h1 class="font-serif text-2xl sm:text-3xl text-ink font-normal" data-i18n="ocr.workspace_title">
          Screenshot Text Extractor & Editor
        </h1>
      </div>

      <!-- Cross-Tool Action Links & Language Selector -->
      <div class="flex flex-wrap items-center gap-2">
        <select id="ocr-lang-select" class="bg-canvas border border-hairline rounded-lg px-2.5 py-1 text-xs font-medium text-ink focus:outline-none focus:border-primary h-9">
          <option value="eng">English (eng)</option>
          <option value="hin">Hindi (हिन्दी / hin)</option>
          <option value="spa">Spanish (Español / spa)</option>
          <option value="fra">French (Français / fra)</option>
          <option value="deu">German (Deutsch / deu)</option>
          <option value="jpn">Japanese (日本語 / jpn)</option>
        </select>

        <button id="ocr-redact-btn" class="btn-secondary text-xs h-9 cursor-pointer" title="Carry image into Redactor">
          <span>Protect in Redactor</span>
          <span>→</span>
        </button>
        <button id="ocr-analyze-btn" class="btn-secondary text-xs h-9 cursor-pointer" title="Carry image into Intelligence Analyzer">
          <span>Investigate Meaning</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- Empty Upload State -->
    <div id="ocr-upload-container" class="bg-surface-card border-2 border-dashed border-hairline rounded-2xl p-8 sm:p-14 text-center cursor-pointer hover:border-primary/50 transition-all mb-8">
      <input type="file" id="ocr-file-input" class="hidden" accept="image/*" />
      <div class="w-14 h-14 rounded-full bg-surface-cream-strong flex items-center justify-center text-primary mx-auto mb-4">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
        </svg>
      </div>
      <h3 class="font-serif text-2xl text-ink font-normal mb-2" data-i18n="ocr.extract_text_title">Extract Text from Any Image</h3>
      <p class="text-xs sm:text-sm text-muted mb-5 max-w-md mx-auto">
        Drop a screenshot, paste from clipboard (<kbd class="px-1.5 py-0.5 rounded bg-surface-cream-strong border border-hairline font-mono text-[11px]">Ctrl+V</kbd>), or click to select
      </p>
      <button type="button" id="ocr-browse-btn" class="btn-primary text-xs sm:text-sm">
        Select Image for OCR
      </button>
    </div>

    <!-- Live OCR Processing Indicator -->
    <div id="ocr-processing-container" class="hidden bg-surface-card border border-hairline rounded-2xl p-8 text-center mb-8">
      <div class="w-10 h-10 border-3 border-primary/20 border-t-primary rounded-full animate-spin mx-auto mb-3"></div>
      <h4 class="font-serif text-xl text-ink font-normal" id="ocr-progress-title">Preprocessing image clarity...</h4>
      <p id="ocr-progress-status" class="text-xs text-muted mt-1">Enhancing contrast, auto-scaling & sharpening...</p>
    </div>

    <!-- Active OCR Split Workspace -->
    <div id="ocr-active-workspace" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left: Image Preview Viewport (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="bg-canvas border border-hairline rounded-xl p-4 sticky top-20">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted font-mono" data-i18n="ocr.source_screenshot">Source Screenshot</span>
            <button id="ocr-new-image-btn" class="text-xs text-primary hover:underline cursor-pointer">Change Image</button>
          </div>
          <div class="relative bg-surface-dark-soft rounded-lg overflow-hidden flex items-center justify-center min-h-[300px] max-h-[500px] border border-hairline">
            <img id="ocr-source-preview" src="" alt="OCR Source" class="max-h-[500px] w-auto object-contain" />
          </div>
          <div id="ocr-preprocessed-badge" class="hidden mt-2 text-[11px] text-muted text-center font-mono">
            ✓ Auto-scaled & contrast normalized for high-accuracy OCR
          </div>
        </div>
      </div>

      <!-- Right: Text Editor & Inspector (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="bg-surface-card border border-hairline rounded-xl p-5 shadow-sm space-y-4">
          <!-- Text Metrics Bar -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-hairline">
            <div class="flex items-center gap-4 text-xs">
              <div><span class="text-muted" data-i18n="ocr.char_count">Characters:</span> <strong id="ocr-char-count" class="font-mono text-ink">0</strong></div>
              <div><span class="text-muted" data-i18n="ocr.word_count">Words:</span> <strong id="ocr-word-count" class="font-mono text-ink">0</strong></div>
              <div><span class="text-muted" data-i18n="ocr.confidence">Confidence:</span> <strong id="ocr-conf-rating" class="font-mono text-success">0%</strong></div>
            </div>

            <!-- Toolbar Actions -->
            <div class="flex items-center gap-2">
              <button id="ocr-copy-text-btn" class="btn-primary text-xs h-8 px-3 cursor-pointer" data-i18n="ocr.copy_text">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Copy Text</span>
              </button>
              <button id="ocr-download-btn" class="btn-secondary text-xs h-8 px-3 cursor-pointer">
                <span>.TXT</span>
              </button>
              <button id="ocr-download-json-btn" class="btn-secondary text-xs h-8 px-3 cursor-pointer">
                <span>.JSON</span>
              </button>
            </div>
          </div>

          <!-- Search Filter Inside Text -->
          <div class="relative">
            <input
              type="text"
              id="ocr-text-filter"
              placeholder="Search extracted text..."
              class="w-full text-xs bg-canvas border border-hairline rounded-lg px-3 py-2 text-ink focus:outline-none focus:border-primary"
            />
          </div>

          <!-- Editable Text Area -->
          <div>
            <textarea
              id="ocr-main-textarea"
              rows="15"
              class="w-full bg-canvas border border-hairline rounded-xl p-4 font-mono text-xs text-ink leading-relaxed focus:outline-none focus:border-primary resize-y select-text"
              placeholder="Extracted text will appear here..."
            ></textarea>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- FAQ Section -->
  <FaqSection faqs={faqs} heading="Frequently Asked Questions About Screenshot OCR" />

  <!-- Contextual Internal Linking -->
  <RelatedLinks currentPath="/screenshot-ocr" />

  <Footer />
</div>

<script>
  import { setHandoffImage, getHandoffImage } from '../../lib/utils/toolHandoff';

  let currentDataUrl = '';
  let lastOcrResult: any = null;

  const dropZone = document.getElementById('ocr-upload-container');
  const fileInput = document.getElementById('ocr-file-input') as HTMLInputElement | null;
  const browseBtn = document.getElementById('ocr-browse-btn');
  const processing = document.getElementById('ocr-processing-container');
  const statusText = document.getElementById('ocr-progress-status');
  const statusTitle = document.getElementById('ocr-progress-title');
  const workspace = document.getElementById('ocr-active-workspace');

  const sourceImg = document.getElementById('ocr-source-preview') as HTMLImageElement | null;
  const textArea = document.getElementById('ocr-main-textarea') as HTMLTextAreaElement | null;
  const charCount = document.getElementById('ocr-char-count');
  const wordCount = document.getElementById('ocr-word-count');
  const confRating = document.getElementById('ocr-conf-rating');
  const langSelect = document.getElementById('ocr-lang-select') as HTMLSelectElement | null;
  const prepBadge = document.getElementById('ocr-preprocessed-badge');

  async function processOcr(dataUrl: string) {
    currentDataUrl = dataUrl;
    dropZone?.classList.add('hidden');
    workspace?.classList.add('hidden');
    processing?.classList.remove('hidden');

    const selectedLang = langSelect?.value || 'eng';

    const img = new Image();
    img.src = dataUrl;
    await new Promise((r) => (img.onload = r));

    if (sourceImg) sourceImg.src = dataUrl;

    try {
      const { runClientOCR } = await import('../../lib/analyzer/ocr');
      const result = await runClientOCR(img, (pct, status) => {
        if (statusText) statusText.innerText = `${status} (${pct}%)`;
        if (pct < 20 && statusTitle) statusTitle.innerText = 'Preprocessing clarity & contrast...';
        else if (statusTitle) statusTitle.innerText = 'Extracting characters & words...';
      }, selectedLang);

      lastOcrResult = result;
      processing?.classList.add('hidden');
      workspace?.classList.remove('hidden');
      prepBadge?.classList.remove('hidden');

      if (textArea) textArea.value = result.text;
      updateMetrics(result.text, result.confidence);
    } catch (e) {
      alert('OCR could not be completed on this image.');
      processing?.classList.add('hidden');
      dropZone?.classList.remove('hidden');
    }
  }

  function updateMetrics(text: string, conf: number = 88) {
    if (charCount) charCount.innerText = String(text.length);
    const words = text.trim().split(/\s+/).filter(Boolean);
    if (wordCount) wordCount.innerText = String(words.length);
    if (confRating) confRating.innerText = `${conf}%`;
  }

  langSelect?.addEventListener('change', () => {
    if (currentDataUrl) {
      processOcr(currentDataUrl);
    }
  });

  dropZone?.addEventListener('click', () => fileInput?.click());
  browseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput?.click();
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.[0]) {
      const reader = new FileReader();
      reader.onload = (e) => processOcr(e.target?.result as string);
      reader.readAsDataURL(fileInput.files[0]);
    }
  });

  document.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.startsWith('image/')) {
        const file = items[i].getAsFile();
        if (file) {
          const reader = new FileReader();
          reader.onload = (ev) => processOcr(ev.target?.result as string);
          reader.readAsDataURL(file);
          break;
        }
      }
    }
  });

  document.getElementById('ocr-new-image-btn')?.addEventListener('click', () => {
    workspace?.classList.add('hidden');
    dropZone?.classList.remove('hidden');
  });

  document.getElementById('ocr-copy-text-btn')?.addEventListener('click', () => {
    if (textArea?.value) {
      navigator.clipboard.writeText(textArea.value);
      alert('Extracted text copied to clipboard!');
    }
  });

  document.getElementById('ocr-download-btn')?.addEventListener('click', () => {
    if (textArea?.value) {
      const blob = new Blob([textArea.value], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `extracted-ocr-${Date.now()}.txt`;
      a.click();
      URL.revokeObjectURL(url);
    }
  });

  document.getElementById('ocr-download-json-btn')?.addEventListener('click', () => {
    if (lastOcrResult) {
      const blob = new Blob([JSON.stringify(lastOcrResult, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `extracted-ocr-data-${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }
  });

  // Cross-Tool Intelligence Handoff
  document.getElementById('ocr-redact-btn')?.addEventListener('click', () => {
    if (currentDataUrl) {
      setHandoffImage(currentDataUrl, 'ocr');
      window.location.href = '/screenshot-redactor';
    }
  });

  document.getElementById('ocr-analyze-btn')?.addEventListener('click', () => {
    if (currentDataUrl) {
      setHandoffImage(currentDataUrl, 'ocr');
      window.location.href = '/';
    }
  });

  // Check for handoff payload from another tool
  const handoff = getHandoffImage();
  if (handoff?.dataUrl) {
    processOcr(handoff.dataUrl);
  }
</script>
