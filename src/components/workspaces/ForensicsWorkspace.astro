---
import DomahanBanner from '../DomahanBanner.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import FaqSection from '../FaqSection.astro';
import ToolGuide from '../ToolGuide.astro';
import RelatedLinks from '../RelatedLinks.astro';
import { getToolFaqs } from '../../data/toolFaqs';

const faqs = getToolFaqs('image-manipulation-checker');
---

<div class="min-h-screen flex flex-col bg-canvas text-body">
  <Header currentPath="/image-manipulation-checker" />

  <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 w-full">
    <!-- Workspace Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="badge-pill !text-xs font-mono font-semibold">Forensics Workspace</span>
          <span class="text-xs text-muted">Error Level Analysis (ELA) & Compression Inspection</span>
        </div>
        <h1 class="font-serif text-2xl sm:text-3xl text-ink font-normal">
          Photo Manipulation Detector: Is This Image Edited?
        </h1>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        <button id="forensics-analyze-btn" class="btn-secondary text-xs h-9" title="Analyze in Intelligence Engine">
          <span>Analyze Meaning</span>
          <span>→</span>
        </button>
        <button id="forensics-new-image-btn" class="btn-secondary text-xs h-9">
          <span>Change Image</span>
        </button>
      </div>
    </div>

    <!-- Empty Upload State -->
    <div id="forensics-upload-container" class="bg-surface-card border-2 border-dashed border-hairline rounded-2xl p-8 sm:p-14 text-center cursor-pointer hover:border-primary/50 transition-all mb-8">
      <input type="file" id="forensics-file-input" class="hidden" accept="image/*" />
      <div class="w-14 h-14 rounded-full bg-surface-cream-strong flex items-center justify-center text-primary mx-auto mb-4">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      </div>
      <h3 class="font-serif text-2xl text-ink font-normal mb-2">Inspect Images for Digital Manipulation</h3>
      <p class="text-xs sm:text-sm text-muted mb-5 max-w-md mx-auto">
        Analyze compression difference heatmaps, Error Level Analysis (ELA), and regional noise variance to spot potential digital edits.
      </p>
      <button type="button" id="forensics-browse-btn" class="btn-primary text-xs sm:text-sm">
        Select Image for Forensics
      </button>
    </div>

    <!-- Active Forensics Workspace -->
    <div id="forensics-active-workspace" class="hidden space-y-6">
      <!-- Top Viewport & Mode Controls -->
      <div class="bg-surface-card border border-hairline rounded-2xl p-5 shadow-sm space-y-4">
        <!-- View Modes Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-hairline">
          <div class="flex items-center gap-1.5" id="forensics-mode-buttons">
            <button type="button" data-mode="ela" class="forensics-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-surface-cream-strong text-primary border border-hairline transition-all">
              Error Level Analysis (ELA)
            </button>
            <button type="button" data-mode="original" class="forensics-mode-btn px-3 py-1.5 rounded-lg text-xs font-medium text-body hover:text-ink hover:bg-canvas transition-all">
              Original Image
            </button>
            <button type="button" data-mode="noise" class="forensics-mode-btn px-3 py-1.5 rounded-lg text-xs font-medium text-body hover:text-ink hover:bg-canvas transition-all">
              Noise Variance Map
            </button>
          </div>

          <span id="forensics-status-pill" class="badge-status-neutral">Checking</span>
        </div>

        <!-- Comparative Image Display -->
        <div class="relative bg-surface-dark-soft rounded-xl overflow-hidden flex items-center justify-center min-h-[380px] max-h-[580px] border border-hairline p-2">
          <div class="relative inline-block max-w-full">
            <img id="forensics-active-view" src="" alt="Forensic Analysis View" class="block max-h-[560px] max-w-full w-auto h-auto shadow-md rounded" />
            <img id="forensics-overlay-view" src="" alt="" aria-hidden="true" class="hidden absolute inset-0 w-full h-full rounded pointer-events-none" />
            <div id="forensics-grid-marks" aria-hidden="true" class="hidden absolute inset-0 pointer-events-none"></div>
          </div>
        </div>

        <!-- ELA view controls (they change the picture only, never the result below) -->
        <div id="ela-controls" class="bg-canvas border border-hairline rounded-xl p-4 space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-semibold text-ink">Adjust the ELA view</h2>
            <button type="button" id="ela-reset" class="btn-secondary text-xs h-9 px-3" disabled>Reset view</button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-5 gap-y-4 text-xs">
            <div>
              <label for="ela-quality" class="flex items-center justify-between gap-2 text-body mb-1.5">
                <span>JPEG quality</span>
                <output id="ela-quality-value" for="ela-quality" class="font-mono text-ink">75%</output>
              </label>
              <input id="ela-quality" type="range" min="50" max="98" step="1" value="75" class="w-full h-6 [accent-color:var(--color-primary)] cursor-pointer" aria-describedby="ela-quality-hint" />
              <p id="ela-quality-hint" class="text-muted mt-1 leading-snug">The quality of the test re-save. Try a value close to how the picture was last saved.</p>
            </div>
            <div>
              <label for="ela-scale" class="flex items-center justify-between gap-2 text-body mb-1.5">
                <span>Error scale</span>
                <output id="ela-scale-value" for="ela-scale" class="font-mono text-ink">25x</output>
              </label>
              <input id="ela-scale" type="range" min="5" max="60" step="1" value="25" class="w-full h-6 [accent-color:var(--color-primary)] cursor-pointer" aria-describedby="ela-scale-hint" />
              <p id="ela-scale-hint" class="text-muted mt-1 leading-snug">How much the differences are brightened. Raise it if the map looks black.</p>
            </div>
            <div>
              <label for="ela-overlay" class="flex items-center justify-between gap-2 text-body mb-1.5">
                <span>Show original on top</span>
                <output id="ela-overlay-value" for="ela-overlay" class="font-mono text-ink">0%</output>
              </label>
              <input id="ela-overlay" type="range" min="0" max="100" step="5" value="0" class="w-full h-6 [accent-color:var(--color-primary)] cursor-pointer" aria-describedby="ela-overlay-hint" />
              <p id="ela-overlay-hint" class="text-muted mt-1 leading-snug">Fades the picture over the map so you can see what a bright patch belongs to.</p>
            </div>
          </div>
          <p id="ela-view-status" class="text-xs text-muted" role="status" aria-live="polite">Compared with a 75% quality re-save, differences shown 25 times brighter.</p>
          <p class="text-xs text-muted leading-relaxed">
            <strong class="text-ink">What this shows:</strong> how strongly each part of the picture changes when it is saved again as a JPEG. A patch that stays much brighter than similar areas around it at several settings is worth a closer look.
          </p>
          <p class="text-xs text-muted leading-relaxed">
            <strong class="text-ink">What it cannot prove:</strong> that a picture was edited or is untouched. Text, sharp edges and re-saved or forwarded pictures light up by themselves, and these sliders change only the view, not the result below.
          </p>
        </div>

        <!-- Metric KPI Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="bg-canvas border border-hairline rounded-xl p-3.5 text-xs">
            <span class="text-muted block mb-0.5">Re-save comparison</span>
            <strong id="forensics-kpi-uniformity" class="font-mono text-ink text-sm">Checking</strong>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-3.5 text-xs">
            <span class="text-muted block mb-0.5">Noise Variance Score</span>
            <strong id="forensics-kpi-noise" class="font-mono text-ink text-sm">12.4</strong>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-3.5 text-xs">
            <span class="text-muted block mb-0.5">Areas that stand out</span>
            <strong id="forensics-kpi-anomalies" class="font-mono text-ink text-sm">Checking</strong>
          </div>
        </div>

        <!-- Area-by-area comparison of the ELA result (feeds the result pill) -->
        <div id="ela-grid-card" class="bg-canvas border border-hairline rounded-xl p-4 space-y-2.5">
          <h2 class="text-sm font-semibold text-ink">Area by area check</h2>
          <p id="ela-grid-headline" class="text-sm text-ink font-medium" role="status" aria-live="polite">Comparing the areas of the picture.</p>
          <ul id="ela-grid-notes" class="text-xs text-body leading-relaxed space-y-1.5 list-disc pl-4"></ul>
          <p class="text-xs text-muted leading-relaxed">
            <strong class="text-ink">What this shows:</strong> the picture is cut into up to 64 areas, and each one is compared with areas that have a similar amount of detail. An area that changes far more than its detail explains is outlined on the ELA map. A dashed outline means the area has hard, clean edges like added text, a sticker or a logo.
          </p>
          <p class="text-xs text-muted leading-relaxed">
            <strong class="text-ink">What it cannot prove:</strong> that a picture was edited or is untouched. Added text, stickers and watermarks stand out by themselves, the dashed outline is a guess from the shape of the edges (a sharp photographed sign can get one too), and an edit saved together with the rest of the picture, or flattened by a messaging app, does not stand out at all.
          </p>
        </div>

        <!-- JPEG quality card (reads the file's own tables; nothing leaves the browser) -->
        <div id="jpeg-quality-card" class="bg-canvas border border-hairline rounded-xl p-4 space-y-2.5">
          <h2 class="text-sm font-semibold text-ink">JPEG save quality</h2>
          <p id="jpeg-quality-headline" class="text-sm text-ink font-medium" role="status" aria-live="polite">Reading the file.</p>
          <ul id="jpeg-quality-notes" class="text-xs text-body leading-relaxed space-y-1.5 list-disc pl-4"></ul>
          <button type="button" id="jpeg-quality-apply" class="btn-secondary text-xs h-9 px-3 hidden"></button>
          <details id="jpeg-quality-tables-wrap" class="text-xs hidden">
            <summary class="cursor-pointer text-body hover:text-ink py-1.5">Show the quantization tables stored in the file</summary>
            <div id="jpeg-quality-tables" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2"></div>
            <p class="text-muted mt-2 leading-snug">Each number is how coarsely one detail level of an 8 by 8 block was rounded when the file was saved. Larger numbers mean stronger compression.</p>
          </details>
          <p class="text-xs text-muted leading-relaxed">
            <strong class="text-ink">What this shows:</strong> the compression level written into the file the last time it was saved as a JPEG, read from the file's own tables.
          </p>
          <p class="text-xs text-muted leading-relaxed">
            <strong class="text-ink">What it cannot prove:</strong> that a picture was edited or is untouched. Every app that saves or forwards a JPEG writes new tables, with or without an edit.
          </p>
        </div>
        <!-- /JPEG quality card -->
      </div>

      <!-- Educational Interpretation Guidance -->
      <div class="bg-canvas border border-hairline rounded-2xl p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-primary shrink-0 mt-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-serif text-xl text-ink font-normal">How to Interpret Forensic Signals</h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed">
              Error Level Analysis (ELA) identifies differences in JPEG compression error rates across an image. Higher brightness areas in an ELA map represent regions that were modified or saved at a different compression ratio than the surrounding canvas.
            </p>
            <p class="text-xs text-muted leading-relaxed">
              <strong class="text-ink">Important Note:</strong> Forensic signals indicate compression variances, which can occur naturally around text edges, high-contrast borders, or re-saved graphics. They are valuable investigatory clues, not absolute proof of fraud.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <DomahanBanner />

  <!-- FAQ Section -->
  <ToolGuide slug="image-manipulation-checker" />
  <FaqSection faqs={faqs} heading="Frequently Asked Questions About Image Forensics & ELA" />

  <!-- Contextual Internal Linking -->
  <RelatedLinks currentPath="/image-manipulation-checker" />

  <Footer />
</div>

<script>
  import { setHandoffImage, getHandoffImage } from '../../lib/utils/toolHandoff';
  import {
    DEFAULT_ELA_VIEW,
    clampElaViewSettings,
    createElaViewRenderer,
    describeElaView,
    isDefaultElaView,
    type ElaViewRenderer,
  } from '../../lib/analyzer/elaView';
  import { describeElaGrid, summarizeForensicsStatus, type ElaGridFinding } from '../../lib/analyzer/elaGrid';
  import { buildJpegQualityReport, dataUrlHeadBytes, type JpegQualityReport } from '../../lib/analyzer/jpegQuality';

  let currentDataUrl = '';
  let currentElaUrl = '';
  let currentForensics: any = null;
  let currentMode = 'ela';
  let elaRenderer: ElaViewRenderer | null = null;

  const dropZone = document.getElementById('forensics-upload-container');
  const fileInput = document.getElementById('forensics-file-input') as HTMLInputElement | null;
  const browseBtn = document.getElementById('forensics-browse-btn');
  const workspace = document.getElementById('forensics-active-workspace');
  const activeView = document.getElementById('forensics-active-view') as HTMLImageElement | null;
  const modeBtns = document.querySelectorAll('.forensics-mode-btn');

  const statusPill = document.getElementById('forensics-status-pill');
  const kpiUniformity = document.getElementById('forensics-kpi-uniformity');
  const kpiNoise = document.getElementById('forensics-kpi-noise');
  const kpiAnomalies = document.getElementById('forensics-kpi-anomalies');

  const overlayView = document.getElementById('forensics-overlay-view') as HTMLImageElement | null;
  const elaControls = document.getElementById('ela-controls');
  const qualityInput = document.getElementById('ela-quality') as HTMLInputElement | null;
  const scaleInput = document.getElementById('ela-scale') as HTMLInputElement | null;
  const overlayInput = document.getElementById('ela-overlay') as HTMLInputElement | null;
  const qualityValue = document.getElementById('ela-quality-value');
  const scaleValue = document.getElementById('ela-scale-value');
  const overlayValue = document.getElementById('ela-overlay-value');
  const elaStatus = document.getElementById('ela-view-status');
  const resetBtn = document.getElementById('ela-reset') as HTMLButtonElement | null;

  const jpegHeadline = document.getElementById('jpeg-quality-headline');
  const jpegNotes = document.getElementById('jpeg-quality-notes');
  const jpegApply = document.getElementById('jpeg-quality-apply') as HTMLButtonElement | null;
  const jpegTablesWrap = document.getElementById('jpeg-quality-tables-wrap') as HTMLDetailsElement | null;
  const jpegTables = document.getElementById('jpeg-quality-tables');
  let jpegSuggestedQuality: number | null = null;

  /** Reads the file's own quantization tables. Runs on the bytes in this tab only. */
  function showJpegQuality(dataUrl: string) {
    let report: JpegQualityReport;
    try {
      report = buildJpegQualityReport(dataUrlHeadBytes(dataUrl));
    } catch {
      report = { format: 'other', tables: [], quality: null, standardTables: false, headline: 'The save quality could not be read from this file.', notes: [] };
    }
    if (jpegHeadline) jpegHeadline.textContent = report.headline;
    if (jpegNotes) {
      jpegNotes.replaceChildren(
        ...report.notes.map((note) => {
          const li = document.createElement('li');
          li.textContent = note;
          return li;
        }),
      );
    }
    if (jpegTables && jpegTablesWrap) {
      jpegTablesWrap.open = false;
      jpegTablesWrap.classList.toggle('hidden', report.tables.length === 0);
      jpegTables.replaceChildren(
        ...report.tables.map((table, index) => {
          const box = document.createElement('div');
          const title = document.createElement('p');
          title.className = 'text-body mb-1';
          title.textContent = `Table ${table.id} (${index === 0 ? 'brightness' : 'colour'})`;
          const grid = document.createElement('pre');
          grid.className = 'font-mono text-[11px] leading-5 text-ink bg-surface-card border border-hairline rounded-lg p-2 overflow-x-auto';
          const rows: string[] = [];
          for (let r = 0; r < 8; r++) {
            rows.push(table.values.slice(r * 8, r * 8 + 8).map((v) => String(v).padStart(3, ' ')).join(' '));
          }
          grid.textContent = rows.join('\n');
          box.append(title, grid);
          return box;
        }),
      );
    }
    // Offer the estimate as the ELA re-save quality when the slider can reach it.
    const clamped = report.quality === null ? null : clampElaViewSettings({ quality: report.quality }).quality;
    jpegSuggestedQuality = clamped !== null && clamped !== DEFAULT_ELA_VIEW.quality ? clamped : null;
    if (jpegApply) {
      jpegApply.classList.toggle('hidden', jpegSuggestedQuality === null);
      if (jpegSuggestedQuality !== null) jpegApply.textContent = `Use ${jpegSuggestedQuality}% in the ELA view`;
    }
  }

  jpegApply?.addEventListener('click', () => {
    if (jpegSuggestedQuality === null || !qualityInput || qualityInput.disabled) return;
    qualityInput.value = String(jpegSuggestedQuality);
    setMode('ela');
    scheduleElaRender();
    elaControls?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  });

  async function processForensics(dataUrl: string) {
    (window as any).scTrack?.('analysis_completed', { result: 'forensics' });
    currentDataUrl = dataUrl;
    dropZone?.classList.add('hidden');
    workspace?.classList.remove('hidden');
    showJpegQuality(dataUrl);

    const img = new Image();
    img.src = dataUrl;
    await new Promise((r) => (img.onload = r));

    const { analyzeImageForensics } = await import('../../lib/analyzer/forensics');
    const result = await analyzeImageForensics(img);
    currentForensics = result;
    currentElaUrl = result.elaDataUrl || dataUrl;

    // The adjustable view starts at the same settings as the analysis and keeps the picture's shape.
    elaRenderer = null;
    resetElaInputs();
    try {
      elaRenderer = createElaViewRenderer(img);
      currentElaUrl = await elaRenderer.render(DEFAULT_ELA_VIEW);
    } catch {
      elaRenderer = null;
    }
    setElaControlsEnabled(Boolean(elaRenderer));
    if (overlayView) overlayView.src = dataUrl;
    setMode('ela');

    if (kpiUniformity) kpiUniformity.innerText = result.compressionInconsistency;
    if (kpiNoise) kpiNoise.innerText = String(result.noiseVarianceScore);
    // Wording and colour come from one place: green only when areas were compared and none stood out.
    const unevenOnly = Boolean(result.elaGrid?.flagged.length) && result.compressionInconsistency === 'Uneven areas observed';
    const status = summarizeForensicsStatus(result.elaGrid, result.anomaliesDetected, unevenOnly);
    const toneText = { warning: 'text-warning', neutral: 'text-ink', clear: 'text-success' }[status.tone];
    const toneBadge = { warning: 'badge-status-warning', neutral: 'badge-status-neutral', clear: 'badge-status-safe' }[status.tone];
    if (kpiAnomalies) {
      kpiAnomalies.innerText = status.areas;
      kpiAnomalies.className = `font-mono ${toneText} text-sm`;
    }
    if (statusPill) {
      statusPill.innerText = status.pill;
      statusPill.className = toneBadge;
    }
    showElaGrid(result.elaGrid);
  }

  const gridHeadline = document.getElementById('ela-grid-headline');
  const gridNotes = document.getElementById('ela-grid-notes');
  const gridMarks = document.getElementById('forensics-grid-marks');

  function showElaGrid(finding: ElaGridFinding | undefined) {
    if (gridMarks) gridMarks.replaceChildren();
    if (!finding) {
      if (gridHeadline) gridHeadline.textContent = 'The area by area check is not available for this picture.';
      if (gridNotes) gridNotes.replaceChildren();
      return;
    }
    const report = describeElaGrid(finding);
    if (gridHeadline) gridHeadline.textContent = report.headline;
    if (gridNotes) {
      gridNotes.replaceChildren(
        ...report.notes.map((note) => {
          const li = document.createElement('li');
          li.textContent = note;
          return li;
        }),
      );
    }
    if (gridMarks) {
      for (const cell of finding.flagged) {
        const mark = document.createElement('div');
        mark.className = 'absolute rounded-sm';
        // Dashed: the area looks like added text or a graphic (a hint from its edges, not proof).
        mark.style.border = `2px ${cell.graphicLike ? 'dashed' : 'solid'} var(--color-warning)`;
        mark.style.left = `${(cell.col / finding.cols) * 100}%`;
        mark.style.top = `${(cell.row / finding.rows) * 100}%`;
        mark.style.width = `${100 / finding.cols}%`;
        mark.style.height = `${100 / finding.rows}%`;
        mark.style.boxShadow = '0 0 0 1px rgba(0,0,0,0.7)';
        gridMarks.appendChild(mark);
      }
    }
    applyGridMarks();
  }

  function applyGridMarks() {
    gridMarks?.classList.toggle('hidden', currentMode !== 'ela' || !gridMarks.childElementCount);
  }

  function setMode(mode: string) {
    currentMode = mode;
    modeBtns.forEach((b) => {
      const active = b.getAttribute('data-mode') === mode;
      b.classList.toggle('bg-surface-cream-strong', active);
      b.classList.toggle('text-primary', active);
      b.classList.toggle('font-semibold', active);
      b.classList.toggle('text-body', !active);
      b.classList.toggle('font-medium', !active);
      b.setAttribute('aria-pressed', String(active));
    });
    elaControls?.classList.toggle('hidden', mode !== 'ela');
    if (activeView) activeView.src = mode === 'original' ? currentDataUrl : currentElaUrl;
    applyOverlay();
    applyGridMarks();
  }

  function readElaSettings() {
    return clampElaViewSettings({
      quality: qualityInput?.value,
      scale: scaleInput?.value,
      overlay: overlayInput?.value,
    });
  }

  function showElaSettings() {
    const settings = readElaSettings();
    if (qualityValue) qualityValue.textContent = `${settings.quality}%`;
    if (scaleValue) scaleValue.textContent = `${settings.scale}x`;
    if (overlayValue) overlayValue.textContent = `${settings.overlay}%`;
    if (elaStatus) elaStatus.textContent = describeElaView(settings);
    if (resetBtn) resetBtn.disabled = !elaRenderer || isDefaultElaView(settings);
    return settings;
  }

  function applyOverlay() {
    if (!overlayView) return;
    const { overlay } = readElaSettings();
    const visible = currentMode === 'ela' && overlay > 0;
    overlayView.classList.toggle('hidden', !visible);
    overlayView.style.opacity = String(overlay / 100);
  }

  function resetElaInputs() {
    if (qualityInput) qualityInput.value = String(DEFAULT_ELA_VIEW.quality);
    if (scaleInput) scaleInput.value = String(DEFAULT_ELA_VIEW.scale);
    if (overlayInput) overlayInput.value = String(DEFAULT_ELA_VIEW.overlay);
    showElaSettings();
    applyOverlay();
  }

  function setElaControlsEnabled(enabled: boolean) {
    [qualityInput, scaleInput].forEach((input) => {
      if (input) input.disabled = !enabled;
    });
    if (!enabled && elaStatus) {
      elaStatus.textContent = 'The adjustable view is not available for this picture. The standard ELA map is shown.';
    }
  }

  let elaRenderTimer: number | undefined;
  let elaRenderRun = 0;

  function scheduleElaRender() {
    const settings = showElaSettings();
    if (!elaRenderer) return;
    window.clearTimeout(elaRenderTimer);
    elaRenderTimer = window.setTimeout(async () => {
      const run = ++elaRenderRun;
      const renderer = elaRenderer;
      if (!renderer) return;
      try {
        const url = await renderer.render(settings);
        // A newer slider move or a new picture wins.
        if (run !== elaRenderRun || renderer !== elaRenderer) return;
        currentElaUrl = url;
        if (currentMode !== 'original' && activeView) activeView.src = url;
      } catch {
        if (elaStatus) elaStatus.textContent = 'Could not redraw the map with these settings. Try Reset view.';
      }
    }, 120);
  }

  qualityInput?.addEventListener('input', scheduleElaRender);
  scaleInput?.addEventListener('input', scheduleElaRender);
  overlayInput?.addEventListener('input', () => {
    showElaSettings();
    applyOverlay();
  });
  resetBtn?.addEventListener('click', () => {
    resetElaInputs();
    scheduleElaRender();
  });

  modeBtns.forEach((btn) => {
    btn.addEventListener('click', () => setMode(btn.getAttribute('data-mode') || 'ela'));
  });

  dropZone?.addEventListener('click', () => fileInput?.click());
  browseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput?.click();
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.[0]) {
      const reader = new FileReader();
      reader.onload = (e) => processForensics(e.target?.result as string);
      reader.readAsDataURL(fileInput.files[0]);
    }
  });

  document.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.startsWith('image/')) {
        const file = items[i].getAsFile();
        if (file) {
          const reader = new FileReader();
          reader.onload = (ev) => processForensics(ev.target?.result as string);
          reader.readAsDataURL(file);
          break;
        }
      }
    }
  });

  document.getElementById('forensics-new-image-btn')?.addEventListener('click', () => {
    workspace?.classList.add('hidden');
    dropZone?.classList.remove('hidden');
  });

  document.getElementById('forensics-analyze-btn')?.addEventListener('click', () => {
    if (currentDataUrl) {
      if (!setHandoffImage(currentDataUrl, 'forensics')) return;
      window.location.href = '/';
    }
  });

  const handoff = getHandoffImage();
  if (handoff?.dataUrl) {
    processForensics(handoff.dataUrl);
  }
</script>
