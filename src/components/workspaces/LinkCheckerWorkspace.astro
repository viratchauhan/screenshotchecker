---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import FaqSection from '../FaqSection.astro';
import RelatedLinks from '../RelatedLinks.astro';
import { getToolFaqs } from '../../data/toolFaqs';

const howItWorksSteps = [
  { step: "1", title: "Paste Any Link", desc: "Enter or paste a web address, SMS link, shortened URL, or message text." },
  { step: "2", title: "Structural & Brand Audit", desc: "Our engine checks domain structures, brand impersonation, '@' authority spoofing, raw IP hosts, and Punycode lookalikes." },
  { step: "3", title: "Reputation & Threat Intel", desc: "Correlates observations with available threat feeds and generates an explainable 0–100 risk score." },
];

const examples = [
  { title: "Reviewing Phishing SMS & WhatsApp Links", desc: "Verify links received in unexpected messages claiming your bank account, SIM card, or parcel delivery requires urgent action." },
  { title: "Detecting Brand Impersonation (Lookalikes)", desc: "Spot fake domains that place trusted brand names into subdomains or hyphens (e.g. sbi.verify-login.xyz vs sbi.co.in)." },
  { title: "Inspecting Hidden URL Shorteners", desc: "Safely determine the true destination hidden behind bit.ly, tinyurl, or t.co links before clicking." },
  { title: "Auditing Unencrypted Plaintext HTTP", desc: "Identify outdated and insecure HTTP connections that transmit credentials and sensitive data in plain text." },
];

const limitations = [
  "Absence of threat intelligence match does NOT guarantee a website is 100% safe. Newly registered phishing websites may not yet appear on public threat feeds.",
  "Never submit passwords, OTPs, or financial information on web pages whose primary root domain does not match the official organization's verified domain.",
  "Safe server-side redirect tracing only resolves public web addresses; internal, private RFC1918, and localhost targets are strictly blocked by our SSRF guard.",
];

const faqs = getToolFaqs('suspicious-link-checker');
---

<div class="flex flex-col min-h-screen bg-canvas text-ink selection:bg-primary/20">
  <Header currentPath="/suspicious-link-checker" />

  <main class="flex-1">
    <!-- Hero Banner -->
    <section class="py-12 sm:py-16 max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-card border border-hairline text-ink text-xs font-semibold uppercase tracking-wider mb-5 font-mono">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        <span>URL & Threat Intelligence</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-ink tracking-tight leading-[1.15] mb-4">
        Suspicious Link Checker
      </h1>

      <p class="font-sans text-sm sm:text-base text-body max-w-2xl mx-auto leading-relaxed mb-6">
        Paste any URL, SMS link, or shortened redirect to analyze brand impersonation, deceptive structures, raw IP hosts, homoglyphs, and reputation indicators.
      </p>

      <div class="inline-flex items-center gap-2 text-xs text-muted bg-surface-card px-3.5 py-1.5 rounded-full border border-hairline font-mono">
        <span class="w-2 h-2 rounded-full bg-success"></span>
        <span>Safe Isolation Sandbox · Browser Never Directly Visits Link</span>
      </div>
    </section>

    <!-- Interactive URL Checker Card -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 pb-12">
      <div class="feature-card !p-6 sm:!p-8 border border-hairline shadow-sm space-y-6">
        <!-- Input Form -->
        <form id="link-checker-form" class="space-y-4">
          <label for="url-input" class="block text-xs font-semibold uppercase tracking-wider text-ink font-mono">
            Paste a link to check:
          </label>

          <div class="relative flex flex-col sm:flex-row gap-2.5">
            <div class="relative flex-1">
              <input
                type="text"
                id="url-input"
                name="url"
                placeholder="https://example.com/login or paste SMS link..."
                required
                autocomplete="off"
                spellcheck="false"
                class="w-full bg-surface-card border border-hairline rounded-lg px-4 py-3.5 text-sm sm:text-base font-mono text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/30 transition-all pr-24"
              />
              <button
                type="button"
                id="paste-clipboard-btn"
                class="absolute right-2 top-1/2 -translate-y-1/2 px-2.5 py-1 rounded bg-surface-cream-strong text-ink hover:text-primary text-xs font-mono border border-hairline transition-colors"
                title="Paste from clipboard"
              >
                Paste
              </button>
            </div>

            <button
              type="submit"
              id="check-link-btn"
              class="btn-primary shrink-0 py-3.5 px-6 font-medium text-sm flex items-center justify-center gap-2"
            >
              <span>Check Link</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>
        </form>

        <!-- Quick Test Samples -->
        <div class="pt-2 border-t border-hairline">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="text-muted font-mono text-[11px] uppercase tracking-wider mr-1">Test Samples:</span>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-error/50 hover:text-error transition-all font-mono text-[11px]"
              data-url="https://sbi.account-verify-login.xyz/kyc-update"
            >
              🚨 Brand Impersonation (SBI)
            </button>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-error/50 hover:text-error transition-all font-mono text-[11px]"
              data-url="http://185.10.10.20/bank/login"
            >
              ⚠️ Raw IP Host
            </button>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-warning/50 hover:text-warning transition-all font-mono text-[11px]"
              data-url="https://xn--appl-43d.com/id/verify"
            >
              🔍 Punycode Homoglyph
            </button>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-primary/50 hover:text-primary transition-all font-mono text-[11px]"
              data-url="https://bit.ly/secure-account-login"
            >
              🔗 URL Shortener
            </button>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-success/50 hover:text-success transition-all font-mono text-[11px]"
              data-url="https://github.com"
            >
              🛡️ Standard HTTPS
            </button>
          </div>
        </div>

        <!-- Scanning Progress State (Hidden by default) -->
        <div id="scanning-state" class="hidden py-8 space-y-4 text-center">
          <div class="w-12 h-12 rounded-full border-2 border-primary border-t-transparent animate-spin mx-auto"></div>
          <div class="space-y-1">
            <h3 class="font-serif text-lg text-ink font-normal">Analyzing Link Security...</h3>
            <p id="scanning-step-text" class="text-xs text-muted font-mono">Normalizing URL structure & checking SSRF guard...</p>
          </div>
        </div>

        <!-- Error State (Hidden by default) -->
        <div id="error-state" class="hidden p-4 rounded-lg bg-error/10 border border-error/20 text-error text-xs space-y-1">
          <div class="font-bold font-mono uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span id="error-title">Analysis Error</span>
          </div>
          <p id="error-message" class="text-body font-sans"></p>
        </div>

        <!-- Result Card Container (Hidden by default) -->
        <div id="result-container" class="hidden space-y-8 pt-6 border-t border-hairline">
          <!-- 1. Header Banner & Verdict -->
          <div id="verdict-banner" class="p-6 rounded-xl border space-y-4 transition-all">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span id="verdict-icon" class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-base"></span>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-muted font-semibold">Link Safety Check</span>
                    <span id="verdict-tag" class="px-2 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider"></span>
                  </div>
                  <h2 id="verdict-heading" class="font-serif text-2xl sm:text-3xl font-normal text-ink mt-0.5"></h2>
                </div>
              </div>

              <!-- Risk Score Gauge -->
              <div class="text-right sm:border-l border-hairline sm:pl-6">
                <span class="text-[11px] font-mono uppercase tracking-wider text-muted block">Risk Score</span>
                <span id="risk-score-display" class="font-serif text-3xl font-normal text-ink">-- / 100</span>
              </div>
            </div>

            <!-- Summary Narrative -->
            <p id="verdict-summary" class="text-xs sm:text-sm text-body leading-relaxed pt-2 border-t border-hairline/40"></p>
          </div>

          <!-- 2. Safe URL Text Display (Non-clickable) -->
          <div class="bg-surface-card border border-hairline rounded-xl p-4 sm:p-5 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-muted font-mono">Submitted URL (Inspected Safely)</span>
              <button
                type="button"
                id="copy-normalized-url-btn"
                class="btn-secondary text-[11px] h-6 px-2 font-mono"
              >
                Copy URL
              </button>
            </div>
            <div class="p-3 rounded bg-canvas border border-hairline font-mono text-xs text-ink break-all select-all">
              <span id="inspected-url-text"></span>
            </div>
          </div>

          <!-- 3. Why This Link Was Flagged (Observations) -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-serif text-xl text-ink font-normal">Security Observations & Evidence</h3>
              <span id="signals-count-badge" class="px-2 py-0.5 rounded bg-surface-card border border-hairline text-muted font-mono text-xs"></span>
            </div>

            <div id="signals-list" class="space-y-3">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- 4. Reputation & Threat Intelligence Feeds Grid -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-serif text-xl text-ink font-normal">Threat Intelligence & Reputation Feeds</h3>
              <span class="text-[11px] text-muted font-mono">Live Multi-Provider Audit</span>
            </div>

            <div id="providers-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- 5. Technical Domain & Structure Breakdown -->
          <div class="space-y-3">
            <h3 class="font-serif text-xl text-ink font-normal">Technical Domain & Structure</h3>
            <div class="bg-surface-card border border-hairline rounded-xl p-4 sm:p-5 text-xs">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 font-mono">
                <div>
                  <span class="text-muted block text-[10px] uppercase">Registered Domain:</span>
                  <span id="tech-reg-domain" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Subdomain:</span>
                  <span id="tech-subdomain" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Protocol:</span>
                  <span id="tech-protocol" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Direct IP Host:</span>
                  <span id="tech-is-ip" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Punycode / IDN:</span>
                  <span id="tech-is-punycode" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Target Port:</span>
                  <span id="tech-port" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Path Depth:</span>
                  <span id="tech-path-depth" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Query Parameters:</span>
                  <span id="tech-query-params" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">UserInfo (@):</span>
                  <span id="tech-userinfo" class="text-ink font-medium"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- 6. Actionable Recommendation -->
          <div id="recommendation-card" class="p-5 rounded-xl border border-hairline bg-surface-card space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-primary"></span>
              <span class="text-xs font-semibold uppercase tracking-wider text-ink font-mono">Recommended Action</span>
            </div>
            <p id="recommendation-text" class="text-xs sm:text-sm text-body leading-relaxed"></p>
          </div>

          <!-- 7. Disclaimer Banner -->
          <div class="p-4 rounded-lg bg-surface-cream-strong/50 border border-hairline text-muted text-[11px] leading-relaxed">
            <span class="font-bold text-ink">Important Security Notice:</span> Automated link checking identifies known threat indicators and structural anomalies. Absence of evidence is not proof of absolute safety. Never enter credentials or sensitive details on unfamiliar websites.
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Checks History (Local storage only) -->
    <section id="history-section" class="max-w-4xl mx-auto px-4 sm:px-6 pb-16 hidden">
      <div class="flex items-center justify-between mb-4">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-primary font-mono block">Your Local Session</span>
          <h2 class="font-serif text-xl sm:text-2xl text-ink font-normal">Recent Link Checks</h2>
        </div>
        <button
          type="button"
          id="clear-history-btn"
          class="btn-secondary text-xs h-7 px-2.5 font-mono"
        >
          Clear History
        </button>
      </div>

      <div class="overflow-x-auto bg-surface-card border border-hairline rounded-xl">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-surface-soft border-b border-hairline text-muted text-[11px]">
            <tr>
              <th class="p-3">Target URL</th>
              <th class="p-3">Verdict</th>
              <th class="p-3">Score</th>
              <th class="p-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="history-table-body" class="divide-y divide-hairline">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- Workflow Section -->
    <section class="py-16 bg-surface-soft border-y border-hairline">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-xl mx-auto mb-12">
          <span class="text-xs uppercase tracking-wider font-semibold text-primary font-mono">Workflow</span>
          <h2 class="font-serif text-2xl sm:text-3xl text-ink font-normal mt-1">
            How the Link Safety Engine Works
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {howItWorksSteps.map((s, idx) => (
            <div class="bg-canvas border border-hairline rounded-lg p-6 flex flex-col justify-between">
              <div>
                <span class="w-7 h-7 rounded-full bg-surface-cream-strong text-primary flex items-center justify-center font-serif text-sm mb-4 font-mono">
                  {idx + 1}
                </span>
                <h3 class="font-serif text-lg text-ink font-normal mb-2">{s.title}</h3>
                <p class="text-xs text-body leading-relaxed">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Practical Examples & Use Cases -->
    <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-10 text-center max-w-xl mx-auto">
        <span class="text-xs uppercase tracking-wider font-semibold text-primary font-mono">Use Cases</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-ink font-normal mt-1">
          When to Check a Link
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {examples.map((ex) => (
          <div class="feature-card !p-6">
            <h3 class="font-serif text-lg text-ink font-normal mb-2">{ex.title}</h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed">{ex.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical Limitations & Security Notice -->
    <section class="py-12 max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-surface-card border border-hairline rounded-xl p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-warning shrink-0 mt-1">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-serif text-xl text-ink font-normal">Technical Limitations & Important Guidance</h3>
            <ul class="list-disc list-inside space-y-1.5 text-xs text-body leading-relaxed pt-1">
              {limitations.map((lim) => (
                <li>{lim}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <FaqSection faqs={faqs} heading="Frequently Asked Questions About Link Security & Phishing" />

    <!-- Contextual Internal Linking -->
    <RelatedLinks currentPath="/suspicious-link-checker" />
  </main>

  <Footer />
</div>

<script>
  import { inspectUrl } from '../../lib/linkChecker/service';
  import type { LinkCheckReport } from '../../lib/linkChecker/types';

  const form = document.getElementById('link-checker-form') as HTMLFormElement | null;
  const urlInput = document.getElementById('url-input') as HTMLInputElement | null;
  const checkBtn = document.getElementById('check-link-btn') as HTMLButtonElement | null;
  const pasteBtn = document.getElementById('paste-clipboard-btn');
  const scanningState = document.getElementById('scanning-state');
  const scanningStepText = document.getElementById('scanning-step-text');
  const errorState = document.getElementById('error-state');
  const errorMsg = document.getElementById('error-message');
  const resultContainer = document.getElementById('result-container');

  // Verdict Elements
  const verdictBanner = document.getElementById('verdict-banner');
  const verdictIcon = document.getElementById('verdict-icon');
  const verdictTag = document.getElementById('verdict-tag');
  const verdictHeading = document.getElementById('verdict-heading');
  const verdictSummary = document.getElementById('verdict-summary');
  const riskScoreDisplay = document.getElementById('risk-score-display');
  const inspectedUrlText = document.getElementById('inspected-url-text');
  const copyUrlBtn = document.getElementById('copy-normalized-url-btn');

  // Details
  const signalsList = document.getElementById('signals-list');
  const signalsCountBadge = document.getElementById('signals-count-badge');
  const providersGrid = document.getElementById('providers-grid');
  const recText = document.getElementById('recommendation-text');

  // Tech Specs
  const techRegDomain = document.getElementById('tech-reg-domain');
  const techSubdomain = document.getElementById('tech-subdomain');
  const techProtocol = document.getElementById('tech-protocol');
  const techIsIp = document.getElementById('tech-is-ip');
  const techIsPunycode = document.getElementById('tech-is-punycode');
  const techPort = document.getElementById('tech-port');
  const techPathDepth = document.getElementById('tech-path-depth');
  const techQueryParams = document.getElementById('tech-query-params');
  const techUserInfo = document.getElementById('tech-userinfo');

  // History
  const historySection = document.getElementById('history-section');
  const historyTableBody = document.getElementById('history-table-body');
  const clearHistoryBtn = document.getElementById('clear-history-btn');

  const HISTORY_KEY = 'screenshotchecker_link_history_v1';

  interface HistoryEntry {
    url: string;
    verdict: string;
    score: number;
    timestamp: number;
  }

  function getHistory(): HistoryEntry[] {
    try {
      const data = localStorage.getItem(HISTORY_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveHistory(entry: HistoryEntry) {
    try {
      const history = getHistory().filter((h) => h.url !== entry.url);
      history.unshift(entry);
      localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(0, 10)));
      renderHistory();
    } catch {}
  }

  function renderHistory() {
    const history = getHistory();
    if (!historySection || !historyTableBody) return;

    if (history.length === 0) {
      historySection.classList.add('hidden');
      return;
    }

    historySection.classList.remove('hidden');
    historyTableBody.innerHTML = history
      .map(
        (h) => `
        <tr class="hover:bg-surface-soft/50 transition-colors">
          <td class="p-3 text-ink truncate max-w-xs">${escapeHtml(h.url)}</td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
              h.verdict === 'DANGEROUS' || h.verdict === 'HIGH_RISK'
                ? 'bg-error/10 text-error border border-error/20'
                : h.verdict === 'SUSPICIOUS' || h.verdict === 'CAUTION'
                ? 'bg-warning/10 text-warning border border-warning/20'
                : 'bg-success/10 text-success border border-success/20'
            }">${h.verdict}</span>
          </td>
          <td class="p-3 text-muted">${h.score}/100</td>
          <td class="p-3 text-right">
            <button type="button" class="text-primary hover:underline recheck-btn" data-url="${escapeHtml(h.url)}">
              Re-check
            </button>
          </td>
        </tr>
      `
      )
      .join('');

    // Re-check button listeners
    document.querySelectorAll('.recheck-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        if (url && urlInput) {
          urlInput.value = url;
          executeCheck(url);
        }
      });
    });
  }

  clearHistoryBtn?.addEventListener('click', () => {
    localStorage.removeItem(HISTORY_KEY);
    renderHistory();
  });

  // Paste from clipboard
  pasteBtn?.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text && urlInput) {
        urlInput.value = text.trim();
        urlInput.focus();
      }
    } catch {
      alert('Unable to read clipboard. Please paste manually into the input box.');
    }
  });

  // Sample Buttons
  document.querySelectorAll('.sample-link-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sampleUrl = btn.getAttribute('data-url');
      if (sampleUrl && urlInput) {
        urlInput.value = sampleUrl;
        executeCheck(sampleUrl);
      }
    });
  });

  // Form Submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!urlInput) return;
    const url = urlInput.value.trim();
    if (url) {
      executeCheck(url);
    }
  });

  async function executeCheck(rawUrl: string) {
    if (!scanningState || !resultContainer || !errorState || !checkBtn) return;

    // Reset UI
    errorState.classList.add('hidden');
    resultContainer.classList.add('hidden');
    scanningState.classList.remove('hidden');
    checkBtn.disabled = true;

    // Animated progress simulation
    const steps = [
      'Normalizing URL structure & checking SSRF guard...',
      'Auditing domain authorities & brand allowlist...',
      'Inspecting authentication keywords & homoglyphs...',
      'Querying reputation feeds & calculating score...',
    ];
    let stepIndex = 0;
    const interval = setInterval(() => {
      stepIndex = (stepIndex + 1) % steps.length;
      if (scanningStepText) scanningStepText.innerText = steps[stepIndex];
    }, 600);

    try {
      const report = await inspectUrl(rawUrl);

      clearInterval(interval);
      scanningState.classList.add('hidden');
      checkBtn.disabled = false;

      renderReport(report);
      saveHistory({
        url: report.target.normalizedUrl,
        verdict: report.verdict,
        score: report.riskScore,
        timestamp: Date.now(),
      });
    } catch (err: any) {
      clearInterval(interval);
      scanningState.classList.add('hidden');
      checkBtn.disabled = false;

      if (errorState && errorMsg) {
        errorMsg.innerText = err.message || 'Please enter a valid HTTP or HTTPS web link.';
        errorState.classList.remove('hidden');
      }
    }
  }

  function renderReport(report: LinkCheckReport) {
    if (!resultContainer) return;

    // Verdict Styling
    if (verdictBanner && verdictTag && verdictHeading && verdictSummary && riskScoreDisplay && verdictIcon) {
      verdictTag.innerText = report.verdict.replace('_', ' ');
      riskScoreDisplay.innerText = `${report.riskScore} / 100`;
      verdictSummary.innerText = report.summary;

      if (report.verdict === 'DANGEROUS') {
        verdictBanner.className = 'p-6 rounded-xl border border-error/30 bg-error/10 space-y-4';
        verdictTag.className = 'px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-error text-white';
        verdictHeading.innerText = 'Critical Threat: Dangerous Link';
        verdictIcon.className = 'w-9 h-9 rounded-full bg-error text-white flex items-center justify-center font-bold text-lg';
        verdictIcon.innerHTML = '✕';
      } else if (report.verdict === 'HIGH_RISK') {
        verdictBanner.className = 'p-6 rounded-xl border border-error/30 bg-error/5 space-y-4';
        verdictTag.className = 'px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-error/90 text-white';
        verdictHeading.innerText = 'High Risk: Impersonation / Deceptive Link';
        verdictIcon.className = 'w-9 h-9 rounded-full bg-error/90 text-white flex items-center justify-center font-bold text-lg';
        verdictIcon.innerHTML = '!';
      } else if (report.verdict === 'SUSPICIOUS') {
        verdictBanner.className = 'p-6 rounded-xl border border-warning/30 bg-warning/10 space-y-4';
        verdictTag.className = 'px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-warning text-ink';
        verdictHeading.innerText = 'Suspicious: Unusual Link Structure';
        verdictIcon.className = 'w-9 h-9 rounded-full bg-warning text-ink flex items-center justify-center font-bold text-lg';
        verdictIcon.innerHTML = '!';
      } else if (report.verdict === 'CAUTION') {
        verdictBanner.className = 'p-6 rounded-xl border border-warning/30 bg-surface-card space-y-4';
        verdictTag.className = 'px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-warning/20 text-warning border border-warning/30';
        verdictHeading.innerText = 'Caution: Minor Security Observations';
        verdictIcon.className = 'w-9 h-9 rounded-full bg-warning/20 text-warning flex items-center justify-center font-bold text-lg';
        verdictIcon.innerHTML = 'i';
      } else if (report.verdict === 'BLOCKED_TARGET') {
        verdictBanner.className = 'p-6 rounded-xl border border-error/30 bg-error/10 space-y-4';
        verdictTag.className = 'px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-error text-white';
        verdictHeading.innerText = 'Blocked: Restricted Network Target';
        verdictIcon.className = 'w-9 h-9 rounded-full bg-error text-white flex items-center justify-center font-bold text-lg';
        verdictIcon.innerHTML = '⛔';
      } else {
        verdictBanner.className = 'p-6 rounded-xl border border-success/30 bg-success/10 space-y-4';
        verdictTag.className = 'px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-success text-white';
        verdictHeading.innerText = 'Low Risk: Standard Link Structure';
        verdictIcon.className = 'w-9 h-9 rounded-full bg-success text-white flex items-center justify-center font-bold text-lg';
        verdictIcon.innerHTML = '✓';
      }
    }

    // Inspected URL display
    if (inspectedUrlText) inspectedUrlText.innerText = report.target.normalizedUrl;
    copyUrlBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(report.target.normalizedUrl);
      alert('Normalized URL copied to clipboard!');
    });

    // Signals / Observations List
    if (signalsList && signalsCountBadge) {
      signalsCountBadge.innerText = `${report.signals.length} Observation${report.signals.length === 1 ? '' : 's'}`;
      if (report.signals.length === 0) {
        signalsList.innerHTML = `
          <div class="p-4 rounded-lg bg-surface-card border border-hairline text-xs text-muted font-sans">
            ✓ No suspicious anomalies, brand theft, or threat intelligence hits detected.
          </div>
        `;
      } else {
        signalsList.innerHTML = report.signals
          .map(
            (s) => `
          <div class="bg-surface-card border border-hairline rounded-lg p-4 text-xs space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="font-serif text-sm font-medium text-ink flex items-center gap-2">
                <span class="${
                  s.severity === 'critical' || s.severity === 'high'
                    ? 'text-error'
                    : s.severity === 'medium'
                    ? 'text-warning'
                    : 'text-muted'
                }">●</span>
                <span>${escapeHtml(s.title)}</span>
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold ${
                s.severity === 'critical'
                  ? 'bg-error/15 text-error border border-error/30'
                  : s.severity === 'high'
                  ? 'bg-error/10 text-error border border-error/20'
                  : s.severity === 'medium'
                  ? 'bg-warning/15 text-warning border border-warning/30'
                  : 'bg-surface-soft text-muted border border-hairline'
              }">${s.severity}</span>
            </div>
            <p class="text-body font-sans leading-relaxed">${escapeHtml(s.description)}</p>
            <div class="pt-1 font-mono text-[11px] text-muted">
              <span class="font-semibold text-ink">Evidence:</span> ${escapeHtml(s.evidence)}
            </div>
          </div>
        `
          )
          .join('');
      }
    }

    // Providers Grid
    if (providersGrid) {
      providersGrid.innerHTML = report.providers
        .map((p) => {
          let statusBadge = '';
          if (p.status === 'MATCH') {
            statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-error/15 text-error border border-error/30">MATCH / THREAT</span>';
          } else if (p.status === 'CLEAN') {
            statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-success/15 text-success border border-success/30">CLEAN</span>';
          } else if (p.status === 'NOT_CONFIGURED') {
            statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-mono text-muted bg-surface-soft border border-hairline">NOT CONFIGURED</span>';
          } else {
            statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-mono text-muted bg-surface-soft border border-hairline">UNAVAILABLE</span>';
          }

          return `
          <div class="bg-surface-card border border-hairline rounded-lg p-3.5 space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <span class="font-medium text-ink">${escapeHtml(p.displayName)}</span>
              ${statusBadge}
            </div>
            <p class="text-muted font-sans text-[11px] leading-relaxed">${escapeHtml(p.details)}</p>
          </div>
        `;
        })
        .join('');
    }

    // Technical Specs
    const d = report.domainDetails;
    if (techRegDomain) techRegDomain.innerText = d.registrableDomain;
    if (techSubdomain) techSubdomain.innerText = d.subdomain;
    if (techProtocol) techProtocol.innerText = d.protocol;
    if (techIsIp) techIsIp.innerText = d.isIpAddress ? 'YES (Numeric IP)' : 'NO (Standard DNS)';
    if (techIsPunycode) techIsPunycode.innerText = d.isPunycode ? `YES (${d.decodedHostname})` : 'NO';
    if (techPort) techPort.innerText = d.port;
    if (techPathDepth) techPathDepth.innerText = `${d.pathDepth} levels`;
    if (techQueryParams) techQueryParams.innerText = `${d.queryParamsCount} parameters`;
    if (techUserInfo) techUserInfo.innerText = d.hasUserInfo ? 'YES (Deceptive Auth)' : 'NO';

    // Recommendation
    if (recText) recText.innerText = report.recommendation;

    // Show result container
    resultContainer.classList.remove('hidden');
    resultContainer.scrollIntoView({ behavior: 'smooth' });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }


  // Init history on load
  renderHistory();
</script>
