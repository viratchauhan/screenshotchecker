---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import FaqSection from '../FaqSection.astro';
import RelatedLinks from '../RelatedLinks.astro';
import { getToolFaqs } from '../../data/toolFaqs';

const howItWorksSteps = [
  { step: "1", title: "Enter URL or Domain", desc: "Paste any full web address, hostname, root domain, or message containing links." },
  { step: "2", title: "Standards Normalization", desc: "Our engine normalizes protocol, case, trailing slashes, and resolves multi-part public suffixes (e.g. .co.uk, .com.au)." },
  { step: "3", title: "Local urldata.csv Lookup", desc: "Checks exact URL, hostname, and registrable domain across 420,000+ local records to determine classification." },
];

const examples = [
  { title: "Verifying Suspicious SMS & Email Links", desc: "Check unknown links received in messages against our 420K+ record dataset to see if they match known bad or good records." },
  { title: "Inspecting Subdomain & Lookalike Spoofs", desc: "Accurately extracts registrable domains using Public Suffix rules so deceptive subdomains cannot impersonate trusted roots." },
  { title: "Checking Exact URL vs Root Domain", desc: "Identifies whether an exact URL path or an entire root domain matches the dataset classification." },
  { title: "Safe Passive Verification", desc: "The local dataset lookup operates completely passively without connecting to or visiting the target server." },
];

const limitations = [
  "No Local Match does NOT guarantee that a website is safe. Newly registered phishing domains or uncataloged websites will not appear in the dataset.",
  "Dataset classifications reflect historical records stored in the dataset and may not reflect recent ownership changes or newly compromised legitimate sites.",
  "Never submit passwords, OTPs, or financial payment details on unfamiliar websites.",
];

const faqs = getToolFaqs('suspicious-link-checker');
---

<div class="flex flex-col min-h-screen bg-canvas text-ink selection:bg-primary/20">
  <Header currentPath="/suspicious-link-checker" />

  <main class="flex-1">
    <!-- Hero Banner -->
    <section class="py-12 sm:py-16 max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-card border border-hairline text-ink text-xs font-semibold uppercase tracking-wider mb-5 font-mono">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        <span>Local URL & Domain Intelligence Engine</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-ink tracking-tight leading-[1.15] mb-4">
        Suspicious Link Checker
      </h1>

      <p class="font-sans text-sm sm:text-base text-body max-w-2xl mx-auto leading-relaxed mb-6">
        Check a URL or domain against our local URL intelligence dataset (420K+ records) and understand whether a matching record was found.
      </p>

      <div class="inline-flex items-center gap-2 text-xs text-muted bg-surface-card px-3.5 py-1.5 rounded-full border border-hairline font-mono">
        <span class="w-2 h-2 rounded-full bg-success"></span>
        <span>Passive Dataset Lookup · Browser Never Connects to Target Link</span>
      </div>
    </section>

    <!-- Interactive URL Checker Card -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 pb-12">
      <div class="feature-card !p-6 sm:!p-8 border border-hairline shadow-sm space-y-6">
        <!-- Input Form -->
        <form id="link-checker-form" class="space-y-4">
          <label for="url-input" class="block text-xs font-semibold uppercase tracking-wider text-ink font-mono">
            Enter URL or domain to check:
          </label>

          <div class="relative flex flex-col sm:flex-row gap-2.5">
            <div class="relative flex-1">
              <input
                type="text"
                id="url-input"
                name="url"
                placeholder="https://example.com/login or domain.com..."
                required
                autocomplete="off"
                spellcheck="false"
                class="w-full bg-surface-card border border-hairline rounded-lg px-4 py-3.5 text-sm sm:text-base font-mono text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/30 transition-all pr-24"
              />
              <button
                type="button"
                id="paste-clipboard-btn"
                class="absolute right-2 top-1/2 -translate-y-1/2 px-2.5 py-1 rounded bg-surface-cream-strong text-ink hover:text-primary text-xs font-mono border border-hairline transition-colors cursor-pointer"
                title="Paste from clipboard"
              >
                Paste
              </button>
            </div>

            <button
              type="submit"
              id="check-link-btn"
              class="btn-primary shrink-0 py-3.5 px-6 font-medium text-sm flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Check URL</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>
        </form>

        <!-- Quick Test Samples -->
        <div class="pt-2 border-t border-hairline">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="text-muted font-mono text-[11px] uppercase tracking-wider mr-1">Dataset Samples:</span>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-error/50 hover:text-error transition-all font-mono text-[11px] cursor-pointer"
              data-url="diaryofagameaddict.com"
            >
              🚨 Known Bad Domain
            </button>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-error/50 hover:text-error transition-all font-mono text-[11px] cursor-pointer"
              data-url="https://crackspider.us/toolbar/install.php?pack=exe"
            >
              🚨 Exact URL Match (Bad)
            </button>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-error/50 hover:text-error transition-all font-mono text-[11px] cursor-pointer"
              data-url="espdesign.com.au"
            >
              🚨 Multi-part TLD (.com.au)
            </button>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-success/50 hover:text-success transition-all font-mono text-[11px] cursor-pointer"
              data-url="https://en.wikipedia.org/wiki/Bernie_Parent"
            >
              🛡️ Exact URL (Good)
            </button>
            <button
              type="button"
              class="sample-link-btn px-2.5 py-1 rounded-full bg-surface-card border border-hairline text-ink hover:border-primary/50 hover:text-primary transition-all font-mono text-[11px] cursor-pointer"
              data-url="myunlisteddomain12345.xyz"
            >
              🔍 No Local Match
            </button>
          </div>
        </div>

        <!-- Scanning Progress State -->
        <div id="scanning-state" class="hidden py-8 space-y-4 text-center">
          <div class="w-12 h-12 rounded-full border-2 border-primary border-t-transparent animate-spin mx-auto"></div>
          <div class="space-y-1">
            <h3 class="font-serif text-lg text-ink font-normal">Querying Local Dataset...</h3>
            <p class="text-xs text-muted font-mono">Searching 420K+ records for URL, hostname, and registrable domain matches...</p>
          </div>
        </div>

        <!-- Error State -->
        <div id="error-state" class="hidden p-4 rounded-lg bg-error/10 border border-error/20 text-error text-xs space-y-1">
          <div class="font-bold font-mono uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span id="error-title">Verification Error</span>
          </div>
          <p id="error-message" class="text-body font-sans"></p>
        </div>

        <!-- Multi-URL Selector Bar -->
        <div id="multi-url-bar" class="hidden p-3 rounded-xl bg-surface-card border border-hairline space-y-2">
          <span class="text-[11px] font-mono uppercase text-muted font-semibold block">Multiple URLs Detected:</span>
          <div id="multi-url-buttons" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Result Card Container -->
        <div id="result-container" class="hidden space-y-8 pt-6 border-t border-hairline">
          <!-- 1. Header Banner & Verdict -->
          <div id="verdict-banner" class="p-6 rounded-xl border space-y-4 transition-all">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span id="verdict-icon" class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg"></span>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-muted font-semibold">Local Verification</span>
                    <span id="verdict-tag" class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider"></span>
                  </div>
                  <h2 id="verdict-heading" class="font-serif text-2xl sm:text-3xl font-normal text-ink mt-0.5"></h2>
                </div>
              </div>

              <!-- Classification & Match Level Badges -->
              <div class="flex items-center gap-3 sm:border-l border-hairline sm:pl-6">
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-muted block">Match Level</span>
                  <span id="match-level-display" class="font-mono text-xs font-semibold text-ink">--</span>
                </div>
                <div class="border-l border-hairline/60 pl-3">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-muted block">Classification</span>
                  <span id="classification-display" class="font-mono text-xs font-bold text-primary">--</span>
                </div>
              </div>
            </div>

            <!-- Summary Narrative -->
            <p id="verdict-summary" class="text-xs sm:text-sm text-body leading-relaxed pt-2 border-t border-hairline/40"></p>
          </div>

          <!-- 2. Match Details Card -->
          <div class="bg-surface-card border border-hairline rounded-xl p-5 space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="font-serif text-lg text-ink font-normal">Dataset Match Breakdown</h3>
              <span id="source-badge" class="text-[11px] font-mono text-muted">Local urldata.csv</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
              <div class="p-3 rounded-lg bg-canvas border border-hairline">
                <span class="text-muted block text-[10px] uppercase">Submitted Target:</span>
                <span id="match-submitted-target" class="text-ink font-medium break-all"></span>
              </div>
              <div class="p-3 rounded-lg bg-canvas border border-hairline">
                <span class="text-muted block text-[10px] uppercase">Matched Record:</span>
                <span id="match-record-value" class="text-ink font-medium break-all"></span>
              </div>
              <div class="p-3 rounded-lg bg-canvas border border-hairline">
                <span class="text-muted block text-[10px] uppercase">Match Level:</span>
                <span id="match-type-full" class="text-ink font-semibold"></span>
              </div>
              <div class="p-3 rounded-lg bg-canvas border border-hairline">
                <span class="text-muted block text-[10px] uppercase">Dataset Label:</span>
                <span id="match-label-full" class="text-ink font-bold"></span>
              </div>
            </div>

            <p id="match-explanation-text" class="text-xs text-body font-sans leading-relaxed pt-2 border-t border-hairline"></p>
          </div>

          <!-- 3. Technical Domain Breakdown -->
          <div class="space-y-3">
            <h3 class="font-serif text-xl text-ink font-normal">Technical Domain & Structure</h3>
            <div class="bg-surface-card border border-hairline rounded-xl p-5 text-xs">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 font-mono">
                <div>
                  <span class="text-muted block text-[10px] uppercase">Registrable Domain:</span>
                  <span id="tech-reg-domain" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Full Hostname:</span>
                  <span id="tech-hostname" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Subdomain:</span>
                  <span id="tech-subdomain" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Protocol:</span>
                  <span id="tech-protocol" class="text-ink font-medium"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Path:</span>
                  <span id="tech-path" class="text-ink font-medium break-all"></span>
                </div>
                <div>
                  <span class="text-muted block text-[10px] uppercase">Port:</span>
                  <span id="tech-port" class="text-ink font-medium"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- 4. Important Security Notice -->
          <div class="p-4 rounded-lg bg-surface-cream-strong/50 border border-hairline text-muted text-[11px] leading-relaxed space-y-1">
            <div class="font-bold text-ink">Important Notice on Local Dataset Verification:</div>
            <p>
              A dataset classification is based on records in ScreenshotChecker's local dataset and may not represent the current or real-time status of the website. A <span class="font-semibold text-ink">NO LOCAL MATCH</span> result indicates that the URL was not found in our local dataset; this does NOT guarantee that the website is safe.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Checks History (Local session) -->
    <section id="history-section" class="max-w-4xl mx-auto px-4 sm:px-6 pb-16 hidden">
      <div class="flex items-center justify-between mb-4">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-primary font-mono block">Your Local Session</span>
          <h2 class="font-serif text-xl sm:text-2xl text-ink font-normal">Recent URL Checks</h2>
        </div>
        <button
          type="button"
          id="clear-history-btn"
          class="btn-secondary text-xs h-7 px-2.5 font-mono cursor-pointer"
        >
          Clear History
        </button>
      </div>

      <div class="overflow-x-auto bg-surface-card border border-hairline rounded-xl">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-surface-soft border-b border-hairline text-muted text-[11px]">
            <tr>
              <th class="p-3">Target URL</th>
              <th class="p-3">Verdict</th>
              <th class="p-3">Match Level</th>
              <th class="p-3">Label</th>
              <th class="p-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="history-table-body" class="divide-y divide-hairline">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- Workflow Section -->
    <section class="py-16 bg-surface-soft border-y border-hairline">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-xl mx-auto mb-12">
          <span class="text-xs uppercase tracking-wider font-semibold text-primary font-mono">Workflow</span>
          <h2 class="font-serif text-2xl sm:text-3xl text-ink font-normal mt-1">
            How Local URL Verification Works
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {howItWorksSteps.map((s, idx) => (
            <div class="bg-canvas border border-hairline rounded-lg p-6 flex flex-col justify-between">
              <div>
                <span class="w-7 h-7 rounded-full bg-surface-cream-strong text-primary flex items-center justify-center font-serif text-sm mb-4 font-mono">
                  {idx + 1}
                </span>
                <h3 class="font-serif text-lg text-ink font-normal mb-2">{s.title}</h3>
                <p class="text-xs text-body leading-relaxed">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Practical Examples & Use Cases -->
    <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-10 text-center max-w-xl mx-auto">
        <span class="text-xs uppercase tracking-wider font-semibold text-primary font-mono">Use Cases</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-ink font-normal mt-1">
          When to Verify a Link
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {examples.map((ex) => (
          <div class="feature-card !p-6">
            <h3 class="font-serif text-lg text-ink font-normal mb-2">{ex.title}</h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed">{ex.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical Limitations -->
    <section class="py-12 max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-surface-card border border-hairline rounded-xl p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-warning shrink-0 mt-1">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-serif text-xl text-ink font-normal">Technical Limitations & Guidance</h3>
            <ul class="list-disc list-inside space-y-1.5 text-xs text-body leading-relaxed pt-1">
              {limitations.map((lim) => (
                <li>{lim}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <FaqSection faqs={faqs} heading="Frequently Asked Questions About Local URL Verification" />

    <!-- Contextual Internal Linking -->
    <RelatedLinks currentPath="/suspicious-link-checker" />
  </main>

  <Footer />
</div>

<script>
  import { checkLink } from '../../lib/linkChecker/client';
  import type { LocalVerificationReport } from '../../lib/linkChecker/types';

  const form = document.getElementById('link-checker-form') as HTMLFormElement | null;
  const urlInput = document.getElementById('url-input') as HTMLInputElement | null;
  const checkBtn = document.getElementById('check-link-btn') as HTMLButtonElement | null;
  const pasteBtn = document.getElementById('paste-clipboard-btn');
  const scanningState = document.getElementById('scanning-state');
  const errorState = document.getElementById('error-state');
  const errorMsg = document.getElementById('error-message');
  const resultContainer = document.getElementById('result-container');

  // Multi URL Bar
  const multiUrlBar = document.getElementById('multi-url-bar');
  const multiUrlButtons = document.getElementById('multi-url-buttons');

  // Verdict Elements
  const verdictBanner = document.getElementById('verdict-banner');
  const verdictIcon = document.getElementById('verdict-icon');
  const verdictTag = document.getElementById('verdict-tag');
  const verdictHeading = document.getElementById('verdict-heading');
  const verdictSummary = document.getElementById('verdict-summary');
  const matchLevelDisplay = document.getElementById('match-level-display');
  const classificationDisplay = document.getElementById('classification-display');

  // Breakdown Card
  const matchSubmittedTarget = document.getElementById('match-submitted-target');
  const matchRecordValue = document.getElementById('match-record-value');
  const matchTypeFull = document.getElementById('match-type-full');
  const matchLabelFull = document.getElementById('match-label-full');
  const matchExplanationText = document.getElementById('match-explanation-text');

  // Tech Specs
  const techRegDomain = document.getElementById('tech-reg-domain');
  const techHostname = document.getElementById('tech-hostname');
  const techSubdomain = document.getElementById('tech-subdomain');
  const techProtocol = document.getElementById('tech-protocol');
  const techPath = document.getElementById('tech-path');
  const techPort = document.getElementById('tech-port');

  // History
  const historySection = document.getElementById('history-section');
  const historyTableBody = document.getElementById('history-table-body');
  const clearHistoryBtn = document.getElementById('clear-history-btn');

  const HISTORY_KEY = 'screenshotchecker_local_url_history_v1';

  interface HistoryEntry {
    url: string;
    verdict: string;
    matchLevel: string;
    label: string;
    timestamp: string;
  }

  function getHistory(): HistoryEntry[] {
    try {
      const data = localStorage.getItem(HISTORY_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveHistory(entry: HistoryEntry) {
    try {
      const current = getHistory().filter((h) => h.url !== entry.url);
      current.unshift(entry);
      localStorage.setItem(HISTORY_KEY, JSON.stringify(current.slice(0, 10)));
      renderHistory();
    } catch {}
  }

  function renderHistory() {
    if (!historySection || !historyTableBody) return;
    const history = getHistory();

    if (history.length === 0) {
      historySection.classList.add('hidden');
      return;
    }

    historySection.classList.remove('hidden');
    historyTableBody.innerHTML = '';

    history.forEach((item) => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-surface-soft/60 transition-colors';

      const isBad = item.verdict === 'KNOWN_BAD' || item.label === 'bad';
      const isGood = item.verdict === 'GOOD' || item.label === 'good';
      const isConflict = item.verdict === 'CONFLICTING';

      const tagClass = isBad
        ? 'text-error bg-error/10'
        : isGood
        ? 'text-success bg-success/10'
        : isConflict
        ? 'text-warning bg-warning/10'
        : 'text-muted bg-surface-card';

      tr.innerHTML = `
        <td class="p-3 truncate max-w-[220px] text-ink font-medium" title="${escapeHtml(item.url)}">
          ${escapeHtml(item.url)}
        </td>
        <td class="p-3">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold ${tagClass}">
            ${item.verdict.replace(/_/g, ' ')}
          </span>
        </td>
        <td class="p-3 text-muted text-[11px]">
          ${item.matchLevel.replace(/_/g, ' ')}
        </td>
        <td class="p-3 font-semibold ${isBad ? 'text-error' : isGood ? 'text-success' : 'text-ink'}">
          ${item.label.toUpperCase()}
        </td>
        <td class="p-3 text-right">
          <button type="button" class="recheck-history-btn text-primary hover:underline text-[11px] cursor-pointer" data-url="${escapeHtml(item.url)}">
            Re-check
          </button>
        </td>
      `;

      historyTableBody.appendChild(tr);
    });

    document.querySelectorAll('.recheck-history-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const url = (e.currentTarget as HTMLElement).getAttribute('data-url');
        if (url && urlInput) {
          urlInput.value = url;
          runVerification(url);
        }
      });
    });
  }

  clearHistoryBtn?.addEventListener('click', () => {
    localStorage.removeItem(HISTORY_KEY);
    renderHistory();
  });

  pasteBtn?.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text && urlInput) {
        urlInput.value = text;
        urlInput.focus();
      }
    } catch {}
  });

  document.querySelectorAll('.sample-link-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const url = (e.currentTarget as HTMLElement).getAttribute('data-url');
      if (url && urlInput) {
        urlInput.value = url;
        runVerification(url);
      }
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!urlInput) return;
    const rawValue = urlInput.value.trim();
    if (rawValue) {
      runVerification(rawValue);
    }
  });

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  async function runVerification(rawInput: string) {
    if (!scanningState || !errorState || !resultContainer || !checkBtn) return;

    errorState.classList.add('hidden');
    resultContainer.classList.add('hidden');
    multiUrlBar?.classList.add('hidden');
    scanningState.classList.remove('hidden');
    checkBtn.disabled = true;

    try {
      const { single: report, reports: multiReports } = await checkLink(rawInput);

      if (!report) {
        throw new Error('Could not verify the URL against the local dataset.');
      }

      // If multiple URLs were found in message, display multi-URL picker tabs
      if (multiReports.length > 1 && multiUrlBar && multiUrlButtons) {
        multiUrlBar.classList.remove('hidden');
        multiUrlButtons.innerHTML = '';

        multiReports.forEach((rep, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isBad = rep.label === 'bad';
          const isGood = rep.label === 'good';
          const badgeColor = isBad
            ? 'border-error text-error bg-error/10'
            : isGood
            ? 'border-success text-success bg-success/10'
            : 'border-hairline text-ink bg-surface-card';

          btn.className = `px-3 py-1.5 rounded-lg border text-xs font-mono transition-all cursor-pointer ${badgeColor} ${idx === 0 ? 'ring-2 ring-primary' : ''}`;
          btn.innerHTML = `<span class="font-bold">${idx + 1}.</span> ${escapeHtml(rep.target.hostname || rep.target.originalUrl)}`;

          btn.addEventListener('click', () => {
            multiUrlButtons.querySelectorAll('button').forEach((b) => b.classList.remove('ring-2', 'ring-primary'));
            btn.classList.add('ring-2', 'ring-primary');
            renderReport(rep);
          });

          multiUrlButtons.appendChild(btn);
        });
      }

      renderReport(report);

      saveHistory({
        url: report.target.originalUrl,
        verdict: report.verdict,
        matchLevel: report.matchLevel,
        label: report.label,
        timestamp: new Date().toISOString(),
      });
    } catch (err: any) {
      if (errorMsg) errorMsg.textContent = err.message || 'Verification failed. Please check the URL syntax.';
      errorState.classList.remove('hidden');
    } finally {
      scanningState.classList.add('hidden');
      checkBtn.disabled = false;
    }
  }

  function renderReport(report: LocalVerificationReport) {
    if (!resultContainer) return;

    let bannerBg = 'bg-surface-card border-hairline';
    let tagClass = 'bg-surface-cream text-ink';
    let iconSvg = '🛡️';
    let headingText = 'No Local Match';

    switch (report.verdict) {
      case 'KNOWN_BAD':
        bannerBg = 'bg-red-500/10 border-red-500/30 text-error';
        tagClass = 'bg-error text-white';
        iconSvg = '🚨';
        headingText = 'Known Bad in Local Dataset';
        break;
      case 'GOOD':
        bannerBg = 'bg-emerald-500/10 border-success/30 text-success';
        tagClass = 'bg-success text-white';
        iconSvg = '🛡️';
        headingText = 'Classified as Good in Local Dataset';
        break;
      case 'CONFLICTING':
        bannerBg = 'bg-amber-500/10 border-warning/30 text-warning';
        tagClass = 'bg-warning text-white';
        iconSvg = '⚠️';
        headingText = 'Conflicting Local Data';
        break;
      case 'INVALID_URL':
        bannerBg = 'bg-error/10 border-error/30 text-error';
        tagClass = 'bg-error text-white';
        iconSvg = '❌';
        headingText = 'Invalid URL Format';
        break;
      default:
        bannerBg = 'bg-sky-500/10 border-sky-500/30 text-ink';
        tagClass = 'bg-stone-200 dark:bg-stone-800 text-ink';
        iconSvg = '✓';
        headingText = 'No Local Match';
        break;
    }

    if (verdictBanner) verdictBanner.className = `p-6 rounded-xl border space-y-4 transition-all ${bannerBg}`;
    if (verdictIcon) verdictIcon.innerHTML = iconSvg;
    if (verdictTag) {
      verdictTag.className = `px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider ${tagClass}`;
      verdictTag.textContent = report.verdict.replace(/_/g, ' ');
    }
    if (verdictHeading) verdictHeading.textContent = headingText;
    if (verdictSummary) verdictSummary.textContent = report.summary;

    if (matchLevelDisplay) {
      matchLevelDisplay.textContent = report.matchLevel.replace(/_/g, ' ');
    }

    if (classificationDisplay) {
      classificationDisplay.textContent = report.label.toUpperCase();
      classificationDisplay.className = `font-mono text-xs font-bold ${
        report.label === 'bad' ? 'text-error' : report.label === 'good' ? 'text-success' : 'text-muted'
      }`;
    }

    // Breakdown details
    if (matchSubmittedTarget) matchSubmittedTarget.textContent = report.target.originalUrl;
    if (matchRecordValue) matchRecordValue.textContent = report.matchedValue || '(none)';
    if (matchTypeFull) matchTypeFull.textContent = report.matchLevel.replace(/_/g, ' ');
    if (matchLabelFull) {
      matchLabelFull.textContent = report.label.toUpperCase();
      matchLabelFull.className = `font-mono font-bold ${
        report.label === 'bad' ? 'text-error' : report.label === 'good' ? 'text-success' : 'text-ink'
      }`;
    }
    if (matchExplanationText) matchExplanationText.textContent = report.explanation;

    // Technical domain details
    const d = report.domainDetails;
    if (techRegDomain) techRegDomain.textContent = d.registrableDomain || '(none)';
    if (techHostname) techHostname.textContent = d.hostname || '(none)';
    if (techSubdomain) techSubdomain.textContent = d.subdomain || '(none)';
    if (techProtocol) techProtocol.textContent = d.protocol || '(none)';
    if (techPath) techPath.textContent = d.pathname || '/';
    if (techPort) techPort.textContent = d.port || '80';

    resultContainer.classList.remove('hidden');
    resultContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Initialize History Table on load
  renderHistory();
</script>
