---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
---

<div class="min-h-screen flex flex-col bg-canvas text-body">
  <Header currentPath="/screenshot-metadata-checker" />

  <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 w-full">
    <!-- Workspace Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="badge-pill !text-xs font-mono font-semibold">Metadata Workspace</span>
          <span class="text-xs text-muted">EXIF & Technical Inspector</span>
        </div>
        <h1 class="font-serif text-2xl sm:text-3xl text-ink font-normal">
          EXIF & Image Metadata Inspector
        </h1>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        <button id="meta-strip-download-btn" class="btn-primary text-xs h-9 px-3.5" title="Strip all EXIF tags and download clean image">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          <span>Strip & Clean Image</span>
        </button>
        <button id="meta-new-image-btn" class="btn-secondary text-xs h-9 px-3">
          <span>Change Image</span>
        </button>
      </div>
    </div>

    <!-- Empty Upload State -->
    <div id="meta-upload-container" class="bg-surface-card border-2 border-dashed border-hairline rounded-2xl p-8 sm:p-14 text-center cursor-pointer hover:border-primary/50 transition-all mb-8">
      <input type="file" id="meta-file-input" class="hidden" accept="image/*" />
      <div class="w-14 h-14 rounded-full bg-surface-cream-strong flex items-center justify-center text-primary mx-auto mb-4">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
        </svg>
      </div>
      <h3 class="font-serif text-2xl text-ink font-normal mb-2">See What Your Image Secretly Reveals</h3>
      <p class="text-xs sm:text-sm text-muted mb-5 max-w-md mx-auto">
        Inspect hidden camera serial numbers, GPS coordinates, editing history, and timestamp markers without uploading to external servers.
      </p>
      <button type="button" id="meta-browse-btn" class="btn-primary text-xs sm:text-sm">
        Select Image to Inspect
      </button>
    </div>

    <!-- Active Metadata Technical Dashboard -->
    <div id="meta-active-dashboard" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left: Image Preview & Quick Overview (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <div class="bg-canvas border border-hairline rounded-xl p-4 sticky top-20">
          <span class="text-xs font-semibold uppercase tracking-wider text-muted font-mono block mb-2">Inspected File</span>
          <div class="bg-surface-dark-soft rounded-lg overflow-hidden flex items-center justify-center min-h-[220px] max-h-[360px] border border-hairline mb-3">
            <img id="meta-preview-img" src="" alt="Metadata preview" class="max-h-[360px] w-auto object-contain" />
          </div>

          <div class="space-y-2 text-xs">
            <div class="flex justify-between"><span class="text-muted">File:</span> <span id="meta-info-name" class="font-mono text-ink truncate">image.png</span></div>
            <div class="flex justify-between"><span class="text-muted">File Size:</span> <span id="meta-info-size" class="font-mono text-ink">0 KB</span></div>
            <div class="flex justify-between"><span class="text-muted">Dimensions:</span> <span id="meta-info-dims" class="font-mono text-ink">0 × 0 px</span></div>
            <div class="flex justify-between"><span class="text-muted">MIME Format:</span> <span id="meta-info-mime" class="font-mono text-ink uppercase">PNG</span></div>
          </div>

          <!-- GPS Warning Callout if found -->
          <div id="meta-gps-alert" class="hidden mt-4 p-3 bg-error/10 border border-error/25 rounded-lg text-xs space-y-1">
            <div class="flex items-center gap-1.5 text-error font-semibold">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>GPS Coordinates Found!</span>
            </div>
            <p id="meta-gps-coords" class="font-mono text-body">0.0000, 0.0000</p>
            <p class="text-[11px] text-muted">This image reveals your exact geographic location when shared.</p>
          </div>
        </div>
      </div>

      <!-- Right: Categorized Key/Value Inspector (8 cols) -->
      <div class="lg:col-span-8 space-y-4">
        <div class="bg-surface-card border border-hairline rounded-xl p-5 shadow-sm space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-hairline">
            <h3 class="font-serif text-xl text-ink font-normal">Technical Metadata Records</h3>
            <div class="flex items-center gap-2">
              <button id="meta-copy-json" class="btn-secondary text-xs h-7 px-2.5">Copy JSON</button>
              <button id="meta-download-json" class="btn-secondary text-xs h-7 px-2.5">.JSON</button>
            </div>
          </div>

          <!-- Category Tables Container -->
          <div id="meta-tables-container" class="space-y-4">
            <!-- Dynamically populated -->
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</div>

<script>
  import { extractMetadata, stripImageMetadata } from '../../lib/analyzer/metadata';
  import { formatBytes } from '../../lib/utils/formatters';
  import { setHandoffImage, getHandoffImage } from '../../lib/utils/toolHandoff';

  let currentFile: File | null = null;
  let currentMetadata: any = null;

  const dropZone = document.getElementById('meta-upload-container');
  const fileInput = document.getElementById('meta-file-input') as HTMLInputElement | null;
  const browseBtn = document.getElementById('meta-browse-btn');
  const dashboard = document.getElementById('meta-active-dashboard');
  const previewImg = document.getElementById('meta-preview-img') as HTMLImageElement | null;

  const infoName = document.getElementById('meta-info-name');
  const infoSize = document.getElementById('meta-info-size');
  const infoDims = document.getElementById('meta-info-dims');
  const infoMime = document.getElementById('meta-info-mime');
  const gpsAlert = document.getElementById('meta-gps-alert');
  const gpsCoords = document.getElementById('meta-gps-coords');
  const tablesContainer = document.getElementById('meta-tables-container');

  async function processMetadata(file: File) {
    currentFile = file;
    dropZone?.classList.add('hidden');
    dashboard?.classList.remove('hidden');

    const reader = new FileReader();
    reader.onload = async (e) => {
      const dataUrl = e.target?.result as string;
      if (previewImg) previewImg.src = dataUrl;

      const img = new Image();
      img.onload = async () => {
        if (infoDims) infoDims.innerText = `${img.width} × ${img.height} px`;
      };
      img.src = dataUrl;

      if (infoName) infoName.innerText = file.name;
      if (infoSize) infoSize.innerText = formatBytes(file.size);
      if (infoMime) infoMime.innerText = file.type.replace('image/', '').toUpperCase() || 'IMAGE';

      const meta = await extractMetadata(file);
      currentMetadata = meta;
      renderMetadataDashboard(meta);
    };
    reader.readAsDataURL(file);
  }

  function renderMetadataDashboard(meta: any) {
    if (meta.gps && gpsAlert && gpsCoords) {
      gpsCoords.innerText = `${meta.gps.lat.toFixed(6)}, ${meta.gps.lng.toFixed(6)}`;
      gpsAlert.classList.remove('hidden');
    } else {
      gpsAlert?.classList.add('hidden');
    }

    if (!tablesContainer) return;

    if (!meta.hasExif && meta.tags.length === 0) {
      tablesContainer.innerHTML = `
        <div class="bg-canvas border border-hairline rounded-xl p-6 text-center text-xs text-muted">
          <p class="font-medium text-body">No EXIF or hardware tags found in this image.</p>
          <p class="mt-1">This file has either already been cleaned or was captured through a platform that strips EXIF tags.</p>
        </div>
      `;
      return;
    }

    // Group tags by category
    const groups: Record<string, any[]> = {};
    for (const tag of meta.tags) {
      const groupName = tag.group || 'General';
      if (!groups[groupName]) groups[groupName] = [];
      groups[groupName].push(tag);
    }

    tablesContainer.innerHTML = Object.entries(groups)
      .map(
        ([group, tags]) => `
      <div class="bg-canvas border border-hairline rounded-xl overflow-hidden text-xs">
        <div class="bg-surface-cream-strong/50 px-4 py-2 font-semibold uppercase tracking-wider text-muted font-mono text-[11px]">
          ${group} Information (${tags.length})
        </div>
        <div class="divide-y divide-hairline">
          ${tags
            .map(
              (t) => `
            <div class="px-4 py-2 flex items-center justify-between gap-4 hover:bg-surface-card/40 transition-colors">
              <span class="text-muted font-mono">${t.tag}</span>
              <span class="font-mono text-ink font-medium text-right truncate max-w-md">${t.value}</span>
            </div>
          `
            )
            .join('')}
        </div>
      </div>
    `
      )
      .join('');
  }

  dropZone?.addEventListener('click', () => fileInput?.click());
  browseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput?.click();
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.[0]) {
      processMetadata(fileInput.files[0]);
    }
  });

  document.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.startsWith('image/')) {
        const file = items[i].getAsFile();
        if (file) {
          processMetadata(file);
          break;
        }
      }
    }
  });

  document.getElementById('meta-new-image-btn')?.addEventListener('click', () => {
    dashboard?.classList.add('hidden');
    dropZone?.classList.remove('hidden');
  });

  document.getElementById('meta-strip-download-btn')?.addEventListener('click', async () => {
    if (!previewImg) return;
    const { blob } = await stripImageMetadata(previewImg, 'image/png');
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `cleaned-${Date.now()}.png`;
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('meta-copy-json')?.addEventListener('click', () => {
    if (currentMetadata) {
      navigator.clipboard.writeText(JSON.stringify(currentMetadata, null, 2));
      alert('Metadata JSON copied to clipboard!');
    }
  });

  document.getElementById('meta-download-json')?.addEventListener('click', () => {
    if (currentMetadata) {
      const blob = new Blob([JSON.stringify(currentMetadata, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `metadata-${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }
  });

  const handoff = getHandoffImage();
  if (handoff?.dataUrl) {
    fetch(handoff.dataUrl)
      .then((r) => r.blob())
      .then((blob) => {
        const file = new File([blob], 'inspected.png', { type: 'image/png' });
        processMetadata(file);
      });
  }
</script>
