<section class="pt-10 pb-8 sm:pt-14 sm:pb-10 max-w-4xl mx-auto px-4 sm:px-6 text-center select-none relative z-10">
  <!-- Brand Capability Badge -->
  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-card border border-hairline text-ink text-xs font-semibold uppercase tracking-wider mb-5">
    <span class="w-2 h-2 rounded-full bg-primary"></span>
    <span data-i18n="hero.badge">Privacy-First Image Intelligence</span>
  </div>

  <!-- Primary Headline -->
  <h1
    class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-ink tracking-tight leading-[1.12] mb-4 max-w-3xl mx-auto"
    data-i18n="hero.title"
  >
    Screenshot Checker – Analyze Screenshots for Digital Evidence
  </h1>

  <!-- Subheading -->
  <p
    class="font-sans text-sm sm:text-base lg:text-lg text-body max-w-2xl mx-auto leading-relaxed mb-6"
    data-i18n="hero.subtitle"
  >
    Upload a screenshot or image to investigate what may be hidden inside it. ScreenshotChecker analyzes visible content, text, metadata, editing signals, and suspicious patterns to help you understand whether an image deserves a closer look.
  </p>

  <!-- Guarantee Pill -->
  <div class="inline-flex items-center gap-2 text-xs text-muted bg-surface-card px-3.5 py-1.5 rounded-full border border-hairline">
    <svg class="w-3.5 h-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>
    <span data-i18n="hero.privacy_pill">Image processing in your browser</span>
  </div>
</section>
