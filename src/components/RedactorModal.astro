---
---

<dialog style="margin:0;width:100%;height:100%;max-width:none;max-height:none;overflow:hidden" aria-labelledby="redactor-title" id="redactor-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-ink/60 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6">
  <div style="max-height:100%;overflow:auto" class="bg-canvas border border-hairline rounded-xl max-w-5xl w-full p-3 sm:p-6 shadow-2xl space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-hairline">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-surface-card flex items-center justify-center text-primary border border-hairline">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
          </svg>
        </div>
        <div>
          <h3 id="redactor-title" class="font-serif text-2xl text-ink font-normal">Screenshot Redactor & Protector</h3>
          <p class="text-xs text-muted">Use solid masks for private data. Blur and pixelate may leave readable detail.</p>
        </div>
      </div>
      <button aria-label="Close redactor" id="close-redactor-modal-btn" class="p-2 text-muted hover:text-ink rounded-lg">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 bg-surface-card p-3 rounded-lg border border-hairline text-xs">
      <!-- Tool Selection -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-muted font-medium">Style:</span>
        <div class="flex flex-wrap items-center gap-1 bg-canvas p-1 rounded-md border border-hairline">
          <button type="button" data-tool="blur" class="redactor-tool-btn px-2.5 py-1 rounded text-muted font-medium">Blur</button>
          <button type="button" data-tool="pixelate" class="redactor-tool-btn px-2.5 py-1 rounded text-muted hover:text-ink font-medium">Pixelate</button>
          <button type="button" data-tool="blackout" class="redactor-tool-btn px-2.5 py-1 rounded bg-surface-card text-ink font-medium">Blackout</button>
          <button type="button" data-tool="whiteout" class="redactor-tool-btn px-2.5 py-1 rounded text-muted hover:text-ink font-medium">Whiteout</button>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2">
        <button id="auto-redact-pii-btn" class="btn-secondary text-xs py-1.5 px-3 h-8">
          <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Auto-Redact Detected PII</span>
        </button>
        <button id="undo-redact-btn" class="btn-secondary text-xs py-1.5 px-3 h-8">
          Undo
        </button>
        <button id="clear-all-redact-btn" class="btn-secondary text-xs py-1.5 px-3 h-8 text-error hover:bg-error/5">
          Clear All
        </button>
      </div>
    </div>

    <!-- Canvas Editing Area -->
    <div data-redaction-stage class="relative bg-surface-dark-soft rounded-lg overflow-auto border border-hairline flex items-center justify-center min-h-[200px] max-h-[550px] p-4 select-none">
      <div class="relative inline-block cursor-crosshair max-w-full">
        <canvas id="redactor-canvas" class="max-w-full max-h-[500px] w-auto block shadow-lg rounded-sm"></canvas>
      </div>
    </div>

    <p id="redactor-status" role="status" class="text-xs">Automatic masks use solid black. Drag with mouse, touch or pen, or enter coordinates below the image. Review before sharing.</p>
    <!-- Footer Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-hairline">
      <div class="text-xs text-muted flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-success"></span>
        <span>Export creates a new flattened image without copying source EXIF metadata. Original image is never modified.</span>
      </div>
      <div class="flex items-center gap-3">
        <button id="cancel-redact-btn" class="btn-secondary text-xs sm:text-sm h-9">
          Cancel
        </button>
        <button id="export-redacted-btn" class="btn-primary text-xs sm:text-sm h-9">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Export Clean & Redacted Image</span>
        </button>
      </div>
    </div>
  </div>
</dialog>
