---
---

<div id="analysis-dashboard" class="hidden max-w-6xl mx-auto px-4 sm:px-6 mb-20 scroll-mt-20">
  <!-- Top Overall Status Banner -->
  <div class="bg-surface-card border border-hairline rounded-xl p-6 sm:p-8 mb-8 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-hairline">
      <div>
        <div class="flex flex-wrap items-center gap-2.5 mb-2">
          <span class="text-xs uppercase tracking-wider font-semibold text-muted font-mono" data-i18n="dashboard.verdict_label">Investigation Verdict</span>
          <span id="authenticity-status-badge" class="badge-status-warning">UNVERIFIABLE</span>
          <span id="agent-modality-badge" class="badge-pill !text-xs font-medium">Multimodal Analysis</span>
        </div>
        <h2 id="overall-status-title" class="font-serif text-3xl sm:text-4xl text-ink font-normal" data-i18n="dashboard.report_title">
          Visual Investigation Report
        </h2>
        <p id="overall-status-summary" class="text-sm text-body mt-2 max-w-3xl leading-relaxed" data-i18n="dashboard.report_subtitle">
          Open-ended multimodal observation, dynamic tool execution, and evidence-first reasoning.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <button id="open-redactor-btn" class="btn-primary text-xs sm:text-sm h-9" data-i18n="dashboard.protect_redact">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
          </svg>
          <span>Protect / Redact</span>
        </button>
        
        <button id="strip-metadata-download-btn" class="btn-secondary text-xs sm:text-sm h-9" data-i18n="dashboard.clean_save">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Clean & Save</span>
        </button>

        <button id="download-report-btn" class="btn-secondary text-xs sm:text-sm h-9" data-i18n="dashboard.export_json" title="Download summary report">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Export JSON</span>
        </button>

        <button id="reset-analysis-btn" class="btn-secondary text-xs sm:text-sm h-9 text-muted hover:text-ink" data-i18n="dashboard.new_scan">
          <span>New Scan</span>
        </button>
      </div>
    </div>

    <!-- Quick Stat KPI Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6">
      <div class="bg-canvas border border-hairline rounded-lg p-3.5">
        <span class="text-xs text-muted block mb-1" data-i18n="dashboard.kpi_verdict">Authenticity Verdict</span>
        <div class="flex items-baseline gap-2">
          <span id="kpi-authenticity-verdict" class="text-sm font-semibold text-ink truncate">UNVERIFIABLE</span>
        </div>
      </div>
      <div class="bg-canvas border border-hairline rounded-lg p-3.5">
        <span class="text-xs text-muted block mb-1" data-i18n="dashboard.kpi_tools">Tools Invoked</span>
        <div class="flex items-baseline gap-2">
          <span id="kpi-tools-count" class="text-xl font-semibold text-ink">0</span>
          <span class="text-xs text-muted-soft">Dynamic</span>
        </div>
      </div>
      <div class="bg-canvas border border-hairline rounded-lg p-3.5">
        <span class="text-xs text-muted block mb-1" data-i18n="dashboard.kpi_evidence">Evidence Traces</span>
        <div class="flex items-baseline gap-2">
          <span id="kpi-evidence-count" class="text-xl font-semibold text-ink">0</span>
          <span class="text-xs text-muted-soft">Chains</span>
        </div>
      </div>
      <div class="bg-canvas border border-hairline rounded-lg p-3.5">
        <span class="text-xs text-muted block mb-1" data-i18n="dashboard.kpi_chars">Extracted Text</span>
        <div class="flex items-baseline gap-2">
          <span id="kpi-ocr-chars" class="text-xl font-semibold text-ink">0</span>
          <span class="text-xs text-muted-soft">Chars</span>
        </div>
      </div>
    </div>
  </div>

  <!-- CROSS-TOOL WORKSPACE HANDOFF LAUNCHER BAR -->
  <div class="bg-surface-cream-strong/50 border border-hairline rounded-xl p-4 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold text-ink uppercase tracking-wider font-mono" data-i18n="dashboard.handoff_label">Cross-Tool Workspaces:</span>
      <span class="text-xs text-muted">Open current image in specialized workspace</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button id="handoff-to-redactor-btn" class="btn-secondary text-xs h-8 px-3">
        <span>Open Redactor</span>
        <span>→</span>
      </button>
      <button id="handoff-to-ocr-btn" class="btn-secondary text-xs h-8 px-3">
        <span>Open OCR Workspace</span>
        <span>→</span>
      </button>
      <button id="handoff-to-metadata-btn" class="btn-secondary text-xs h-8 px-3">
        <span>Inspect EXIF</span>
        <span>→</span>
      </button>
      <button id="handoff-to-forensics-btn" class="btn-secondary text-xs h-8 px-3">
        <span>Run ELA Forensics</span>
        <span>→</span>
      </button>
    </div>
  </div>

  <!-- FRAUD ANALYSIS RESULTS -->
  <div id="fraud-analysis-section" class="hidden mb-8 space-y-6">
    <div class="feature-card !p-6 sm:!p-8 bg-surface-cream-strong/40 border-primary/20">
      <div class="flex items-center gap-2 mb-3">
        <span id="fraud-pulsing-dot" class="w-2.5 h-2.5 rounded-full bg-error animate-pulse"></span>
        <span class="text-xs uppercase tracking-wider font-semibold text-error font-mono" id="fraud-risk-level-label">HIGH RISK</span>
      </div>
      <h3 id="fraud-score-title" class="font-serif text-3xl sm:text-5xl text-ink font-normal mb-4">
        94/100
      </h3>
      <p id="fraud-score-method" class="text-xs text-muted mb-4">Rule-based reference-pattern score, not a probability of fraud or authenticity. A low score or no reference match does not verify a payment or establish safety.</p>

      <div class="space-y-6">
        <div>
          <h4 class="font-serif text-xl text-ink font-normal mb-2" data-i18n="fraud.what_message_says">What is this message saying?</h4>
          <p id="fraud-summary" class="text-base text-body leading-relaxed font-medium bg-canvas p-4 rounded border border-hairline"></p>
        </div>

        <div>
          <h4 class="font-serif text-xl text-ink font-normal mb-3" data-i18n="fraud.why_suspicious">Why is it suspicious?</h4>
          <div id="fraud-signals-list" class="space-y-3 grid grid-cols-1 gap-3">
            <!-- Dynamically filled -->
          </div>
        </div>

        <!-- 4-Card Detected Elements Grid -->
        <div class="space-y-2">
          <h4 class="font-serif text-lg text-ink font-normal">Detected Elements</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
            <div class="bg-canvas border border-hairline p-3 rounded-lg">
              <span class="font-mono text-[10px] uppercase text-muted font-bold block mb-1">Claimed Organization</span>
              <p id="fraud-claimed-org" class="font-medium text-ink truncate"></p>
            </div>
            <div class="bg-canvas border border-hairline p-3 rounded-lg">
              <span class="font-mono text-[10px] uppercase text-muted font-bold block mb-1">Detected Scam Category</span>
              <p id="fraud-scam-type" class="font-medium text-ink truncate"></p>
            </div>
            <div class="bg-canvas border border-hairline p-3 rounded-lg">
              <span class="font-mono text-[10px] uppercase text-muted font-bold block mb-1">Extracted URL</span>
              <p id="fraud-detected-url" class="font-mono text-ink truncate">None</p>
            </div>
            <div class="bg-canvas border border-hairline p-3 rounded-lg">
              <span class="font-mono text-[10px] uppercase text-muted font-bold block mb-1">Attachment / Payload</span>
              <p id="fraud-detected-attachment" class="font-medium text-ink truncate">None detected</p>
            </div>
            <div class="bg-canvas border border-hairline p-3 rounded-lg">
              <span class="font-mono text-[10px] uppercase text-muted font-bold block mb-1">Callback / Phone</span>
              <p id="fraud-detected-phone" class="font-mono text-ink truncate">None</p>
            </div>
            <div class="bg-canvas border border-hairline p-3 rounded-lg">
              <span class="font-mono text-[10px] uppercase text-muted font-bold block mb-1">Demanded Action</span>
              <p id="fraud-requested-action" class="font-medium text-ink truncate"></p>
            </div>
          </div>
        </div>

        <div class="bg-error/10 border border-error/20 p-5 rounded-lg mt-4">
          <h4 class="font-serif text-xl text-error font-semibold mb-2" data-i18n="fraud.what_to_do">What should you do?</h4>
          <p id="fraud-recommendation" class="text-sm sm:text-base text-error/90 font-medium"></p>
        </div>
      </div>
    </div>
  </div>

  <!-- AGENTIC INVESTIGATION PLAN & OPEN-ENDED OBSERVATION -->
  <div id="agentic-investigation-section" class="mb-8 space-y-6">
    <!-- Lead Finding Card: What Am I Looking At? -->
    <div class="feature-card !p-6 sm:!p-8 bg-surface-cream-strong/40 border-primary/20">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
        <span class="text-xs uppercase tracking-wider font-semibold text-primary font-mono">Open-Ended Visual Understanding</span>
      </div>
      <h3 id="investigator-heading" class="font-serif text-2xl sm:text-3xl text-ink font-normal mb-3" data-i18n="investigator.what_is_this_title">
        What Am I Looking At?
      </h3>
      <p id="investigator-what-is-this" class="text-base text-body leading-relaxed mb-6 font-medium">
        Observing visual image...
      </p>

      <!-- Dynamic Investigation Plan Summary -->
      <div class="bg-canvas border border-hairline rounded-lg p-4 mb-4">
        <span class="text-xs font-semibold text-ink uppercase tracking-wider block mb-2 font-mono" data-i18n="investigator.plan_title">Dynamic Investigation Plan</span>
        <div id="investigator-plan-steps" class="space-y-1.5 text-xs text-body font-mono">
          <!-- Dynamically filled -->
        </div>
      </div>

      <!-- Action Guidance Callout -->
      <div class="bg-canvas border border-hairline rounded-lg p-4 flex items-start gap-3.5">
        <div class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-ink uppercase tracking-wider block mb-0.5 font-mono" data-i18n="investigator.rec_next_step">Recommended Next Step</span>
          <p id="investigator-recommended-action" class="text-xs sm:text-sm text-body leading-relaxed">
            Verify details independently before taking action.
          </p>
        </div>
      </div>
    </div>

    <!-- 4-Card Investigator Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Card 1: What Is Happening & Claimed -->
      <div class="feature-card">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h4 class="font-serif text-xl text-ink font-normal" data-i18n="investigator.what_it_claims_title">What Is Happening & Claimed</h4>
        </div>
        <p id="investigator-what-it-claims" class="text-xs sm:text-sm text-body leading-relaxed mb-3">
          Analyzing claims...
        </p>
        <div id="claims-details-container" class="pt-2 border-t border-hairline space-y-1 text-xs text-muted">
          <!-- Dynamically filled -->
        </div>
      </div>

      <!-- Card 2: What It Wants You To Do -->
      <div class="feature-card">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
          </svg>
          <h4 class="font-serif text-xl text-ink font-normal" data-i18n="investigator.what_it_wants_title">What It Wants You To Do</h4>
        </div>
        <div class="space-y-3">
          <p id="investigator-action-desc" class="text-xs sm:text-sm text-body leading-relaxed">
            No immediate action or transfer demanded.
          </p>
        </div>
      </div>

      <!-- Card 3: What We Found (Structured Data & Tools) -->
      <div class="feature-card">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <h4 class="font-serif text-xl text-ink font-normal" data-i18n="investigator.what_we_found_title">What We Found (Structured Evidence)</h4>
        </div>
        <ul id="investigator-found-list" class="space-y-2 text-xs sm:text-sm text-body list-disc list-inside">
          <!-- Dynamically filled -->
        </ul>
      </div>

      <!-- Card 4: Can We Verify It & Authenticity Limits -->
      <div class="feature-card">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <h4 class="font-serif text-xl text-ink font-normal" data-i18n="investigator.can_verify_title">Can We Verify It? (Authenticity Limits)</h4>
        </div>
        <div class="space-y-3">
          <div class="bg-canvas border border-hairline rounded-lg p-3 text-xs">
            <p id="investigator-can-verify" class="text-body leading-relaxed">
              No. Independent external verification is unavailable.
            </p>
          </div>
          <ul id="investigator-concerns-list" class="space-y-2 text-xs sm:text-sm text-body list-disc list-inside">
            <!-- Dynamically filled -->
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- EVIDENCE-FIRST REASONING CHAINS -->
  <div class="feature-card mb-8">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-primary">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h3 class="font-serif text-xl font-normal text-ink" data-i18n="investigator.evidence_chains_title">Evidence-First Reasoning Chains</h3>
          <p class="text-xs text-muted">Complete reasoning trace from visual observation to concrete recommendation</p>
        </div>
      </div>
      <span id="evidence-chains-count-badge" class="badge-pill">0 Chains</span>
    </div>

    <div id="evidence-chains-list" class="space-y-4">
      <!-- Dynamically filled -->
    </div>
  </div>

  <!-- Technical Analysis Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left Column: Image Preview (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-canvas border border-hairline rounded-xl p-4 sticky top-24">
        <div class="flex items-center justify-between mb-3 px-1">
          <span class="font-sans text-xs font-semibold text-ink uppercase tracking-wider font-mono">Analyzed Screenshot</span>
          <span id="preview-image-specs" class="text-xs text-muted font-mono">0 x 0</span>
        </div>
        <div class="relative bg-surface-dark-soft rounded-lg overflow-hidden flex items-center justify-center min-h-[260px] max-h-[460px] border border-hairline">
          <img id="preview-image" src="" alt="Analyzed screenshot preview" class="max-h-[460px] w-auto object-contain" />
          <canvas id="preview-overlay-canvas" class="absolute inset-0 pointer-events-none w-full h-full"></canvas>
        </div>

        <div class="mt-4 pt-3 border-t border-hairline grid grid-cols-2 gap-2 text-xs text-body font-mono">
          <div><span class="text-muted">File:</span> <span id="img-info-name" class="text-ink truncate block">image.png</span></div>
          <div><span class="text-muted">Size:</span> <span id="img-info-size" class="text-ink">0 KB</span></div>
          <div><span class="text-muted">Aspect Ratio:</span> <span id="img-info-ratio" class="text-ink">1:1</span></div>
          <div><span class="text-muted">Format:</span> <span id="img-info-format" class="text-ink uppercase">PNG</span></div>
        </div>
      </div>
    </div>

    <!-- Right Column: Technical Modules (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- MODULE 1: Privacy & Sensitive Information -->
      <div class="feature-card" id="module-privacy">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-primary">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-normal text-ink">Privacy & Sensitive Information</h3>
              <p class="text-xs text-muted">Detects personal identifying info (emails, cards, phones, SSNs, and GPS)</p>
            </div>
          </div>
          <span id="privacy-count-badge" class="badge-pill font-mono">0 items</span>
        </div>

        <div id="privacy-findings-list" class="space-y-2.5">
          <!-- Dynamically filled -->
        </div>
      </div>

      <!-- MODULE 2: Links & Web Destinations -->
      <div class="feature-card" id="module-links">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-primary">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-normal text-ink">Extracted Links & Web Destinations</h3>
              <p class="text-xs text-muted">URL security structure, IP hostnames, shorteners, and protocol checks</p>
            </div>
          </div>
          <span id="links-count-badge" class="badge-pill font-mono">0 URLs</span>
        </div>

        <div id="links-findings-list" class="space-y-2.5">
          <!-- Dynamically filled -->
        </div>
      </div>

      <!-- MODULE 3: Metadata Inspector -->
      <div class="feature-card" id="module-metadata">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-ink">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-normal text-ink">Image Metadata & EXIF</h3>
              <p class="text-xs text-muted">Camera device, software editor tags, GPS, and timestamp records</p>
            </div>
          </div>
          <button id="inline-strip-metadata-btn" class="btn-secondary text-xs py-1.5 px-3 h-8">
            Strip Metadata
          </button>
        </div>

        <div id="metadata-details-container" class="space-y-3">
          <!-- Dynamically filled -->
        </div>
      </div>

      <!-- MODULE 4: OCR Text -->
      <div class="feature-card" id="module-ocr">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-ink">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-normal text-ink">OCR / Extracted Text</h3>
              <p class="text-xs text-muted">Searchable, exportable text extracted directly in your browser</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button id="copy-ocr-btn" class="btn-secondary text-xs py-1.5 px-3 h-8">
              Copy Text
            </button>
            <button id="download-ocr-txt-btn" class="btn-secondary text-xs py-1.5 px-3 h-8">
              .TXT
            </button>
          </div>
        </div>

        <div class="space-y-3">
          <div class="relative">
            <input
              type="text"
              id="ocr-search-input"
              placeholder="Search in extracted text..."
              class="w-full text-xs bg-canvas border border-hairline rounded-md px-3 py-2 text-ink focus:outline-none focus:border-primary"
            />
          </div>

          <div id="ocr-text-display" class="bg-canvas border border-hairline rounded-lg p-4 font-mono text-xs text-ink max-h-56 overflow-y-auto whitespace-pre-wrap leading-relaxed select-text">
            No text detected.
          </div>
        </div>
      </div>

      <!-- MODULE 5: Forensics & ELA -->
      <div class="feature-card" id="module-forensics">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-surface-cream-strong flex items-center justify-center text-ink">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-normal text-ink">Image Manipulation Signals</h3>
              <p class="text-xs text-muted">Error Level Analysis (ELA) and compression difference heatmaps</p>
            </div>
          </div>
          <button id="toggle-ela-btn" class="btn-secondary text-xs py-1.5 px-3 h-8">
            Toggle ELA Map
          </button>
        </div>

        <div id="forensics-details-container" class="space-y-3">
          <!-- Dynamically filled -->
        </div>
      </div>
    </div>
  </div>
</div>
