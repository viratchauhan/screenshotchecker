---
const languages = [
  { code: 'en', name: 'English', short: 'EN' },
  { code: 'hi', name: 'हिन्दी', short: 'HI' },
  { code: 'es', name: 'Español', short: 'ES' },
  { code: 'fr', name: 'Français', short: 'FR' },
  { code: 'de', name: 'Deutsch', short: 'DE' },
  { code: 'ja', name: '日本語', short: 'JA' },
];
---

<div class="relative inline-block text-left" id="lang-selector-container">
  <button
    id="lang-selector-btn"
    type="button"
    class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-body hover:text-ink rounded-lg hover:bg-surface-card border border-transparent hover:border-hairline transition-colors h-9 cursor-pointer"
    aria-label="Select language"
  >
    <span id="current-lang-label">EN</span>
    <svg class="w-3 h-3 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    id="lang-dropdown"
    class="hidden absolute right-0 mt-2 w-36 rounded-xl bg-canvas border border-hairline shadow-2xl p-1 z-50 transition-all text-xs font-medium"
    style="background-color: var(--color-canvas); opacity: 1 !important;"
  >
    {languages.map((lang) => (
      <button
        type="button"
        data-lang-code={lang.code}
        class="lang-choice-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg hover:bg-surface-card text-body hover:text-ink text-left cursor-pointer"
      >
        <span>{lang.name}</span>
        <span class="text-[10px] font-mono text-muted uppercase">{lang.short}</span>
      </button>
    ))}
  </div>
</div>

<script>
  function setupLangSelector() {
    const btn = document.getElementById('lang-selector-btn');
    const dropdown = document.getElementById('lang-dropdown');
    const choices = document.querySelectorAll('.lang-choice-btn');

    // Only load full i18n dictionaries if user previously selected a non-English language
    try {
      const savedLang = localStorage.getItem('sc_lang');
      if (savedLang && savedLang !== 'en') {
        import('../i18n').then(({ initI18n }) => initI18n());
      }
    } catch (_) {}

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown?.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      dropdown?.classList.add('hidden');
    });

    choices.forEach((choice) => {
      choice.addEventListener('click', async () => {
        const code = choice.getAttribute('data-lang-code') || 'en';
        const { setAppLanguage } = await import('../i18n');
        setAppLanguage(code as any);
        dropdown?.classList.add('hidden');
      });
    });
  }

  setupLangSelector();
  document.addEventListener('astro:page-load', setupLangSelector);
</script>
