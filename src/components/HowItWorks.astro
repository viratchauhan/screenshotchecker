---
---

<section class="py-20 bg-surface-soft border-y border-hairline">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs uppercase tracking-wider font-semibold text-primary">Transparent Architecture</span>
      <h2 class="font-serif text-3xl sm:text-4xl text-ink font-normal mt-2 mb-4">
        How Screenshot Checker Works
      </h2>
      <p class="text-sm sm:text-base text-muted leading-relaxed">
        Everything runs locally in your browser sandbox using Web Workers, HTML5 Canvas, and WebAssembly.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Steps List (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="flex gap-4 items-start">
          <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-serif text-sm shrink-0">
            1
          </div>
          <div>
            <h3 class="font-serif text-lg text-ink font-normal mb-1">Local Image Decoding</h3>
            <p class="text-sm text-body leading-relaxed">
              When you drop, pick, or paste an image, the browser reads it directly into memory via FileReader. No network upload request is dispatched.
            </p>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-serif text-sm shrink-0">
            2
          </div>
          <div>
            <h3 class="font-serif text-lg text-ink font-normal mb-1">Parallel Browser Analysis</h3>
            <p class="text-sm text-body leading-relaxed">
              WebAssembly OCR extracts visible text, regex engines scan for sensitive PII, ExifReader parses binary metadata tags, and Canvas computes compression ELA.
            </p>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-serif text-sm shrink-0">
            3
          </div>
          <div>
            <h3 class="font-serif text-lg text-ink font-normal mb-1">Redaction & Clean Export</h3>
            <p class="text-sm text-body leading-relaxed">
              Select sensitive areas to blur, pixelate, or black out. Export a clean, metadata-free copy safely without saving anything to a remote database.
            </p>
          </div>
        </div>
      </div>

      <!-- Dark Product Chrome / Code Window (7 cols) -->
      <div class="lg:col-span-7">
        <div class="product-mockup-dark shadow-xl">
          <!-- Window Chrome Header -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10 text-xs text-on-dark-soft font-mono">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-error/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-warning/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-success/80 inline-block"></span>
              <span class="ml-2 text-on-dark font-sans font-medium">client-pipeline.ts</span>
            </div>
            <span class="text-accent-teal">● LOCAL EXECUTION</span>
          </div>

          <!-- Code / Pipeline Visualization -->
          <div class="font-mono text-xs text-on-dark leading-relaxed space-y-2 overflow-x-auto">
            <p class="text-on-dark-soft">// 1. File loaded in local browser memory</p>
            <p><span class="text-accent-amber">const</span> blob = <span class="text-accent-teal">await</span> file.<span class="text-primary">arrayBuffer</span>();</p>
            <p class="text-on-dark-soft">// 2. Multi-vector audit in isolated Web Worker</p>
            <p><span class="text-accent-amber">const</span> [metadata, ocrText] = <span class="text-accent-teal">await Promise</span>.<span class="text-primary">all</span>([</p>
            <p class="pl-4">ExifReader.<span class="text-primary">load</span>(blob, &#123; expanded: <span class="text-accent-amber">true</span> &#125;),</p>
            <p class="pl-4">tesseractWorker.<span class="text-primary">recognize</span>(imageCanvas),</p>
            <p>]);</p>
            <p class="text-on-dark-soft">// 3. Client-side risk & privacy heuristics</p>
            <p><span class="text-accent-amber">const</span> report = <span class="text-primary">evaluatePrivacyAndScamSignals</span>(ocrText, metadata);</p>
            <p class="text-success font-semibold">✓ Status: REVIEW_RECOMMENDED | Findings: 3 | Transmitted: 0 Bytes</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
