---
import { HOMEPAGE_FAQS } from '../data/homepageFaqs';

interface Props {
  faqs?: typeof HOMEPAGE_FAQS;
}

const { faqs = HOMEPAGE_FAQS } = Astro.props;
---

<section class="py-20 max-w-4xl mx-auto px-4 sm:px-6">
  <div class="text-center max-w-2xl mx-auto mb-14">
    <span class="text-xs uppercase tracking-wider font-semibold text-primary">Frequently Asked Questions</span>
    <h2 class="font-serif text-3xl sm:text-4xl text-ink font-normal mt-2 mb-4">
      Frequently Asked Questions About Screenshot Checker
    </h2>
    <p class="text-sm text-muted">
      Clear, honest answers on screenshot analysis, verification realities, and privacy.
    </p>
  </div>

  <div class="space-y-4" id="faq-accordion">
    {faqs.map((faq, index) => (
      <div class="feature-card !p-5 sm:!p-6 cursor-pointer group transition-all" data-faq-index={index}>
        <button
          type="button"
          class="w-full flex items-center justify-between text-left gap-4 font-serif text-lg text-ink font-normal focus:outline-none"
          aria-expanded="false"
        >
          <span>{faq.question}</span>
          <svg class="w-5 h-5 text-primary shrink-0 transition-transform duration-200 faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="faq-answer hidden mt-3 pt-3 border-t border-hairline text-sm text-body leading-relaxed">
          <p>{faq.answer}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const faqCards = document.querySelectorAll('#faq-accordion .feature-card');
  faqCards.forEach((card) => {
    const btn = card.querySelector('button');
    const answer = card.querySelector('.faq-answer');
    const icon = card.querySelector('.faq-icon');

    btn?.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      answer?.classList.toggle('hidden');
      icon?.classList.toggle('rotate-180');
    });
  });
</script>
