---
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  siteName?: string;
  structuredData?: object;
  robots?: string;
  lang?: string;
}

const {
  title = "Screenshot Checker: Is This Screenshot Real or Fake?",
  description = "Free screenshot checker and fake screenshot detector. Test any chat, payment or social media screenshot for edits and scam signs, privately in your browser. No upload, no signup.",
  canonicalUrl: propCanonicalUrl,
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage: ogImageProp,
  siteName = "ScreenshotChecker",
  structuredData,
  robots = "index, follow",
  lang = "en",
} = Astro.props;

// Microsoft Clarity (heatmaps). Off unless PUBLIC_CLARITY_ID is set at build time.
// Only content pages load it: tool pages can display text extracted from private screenshots.
const clarityId = (import.meta.env.PUBLIC_CLARITY_ID || '').trim();
const clarityPathAllowed = /^\/(blog|resources|tools|about|contact)(\/|$)/.test(Astro.url.pathname);
const loadClarity = /^[a-z0-9]{6,20}$/i.test(clarityId) && clarityPathAllowed;

// Standardize canonical URL with trailing slash matching sitemap format
const pathname = Astro.url.pathname;
const normalizedPath = pathname === '/' ? '/' : (pathname.endsWith('/') ? pathname : `${pathname}/`);
const canonicalUrl = propCanonicalUrl 
  ? (propCanonicalUrl.endsWith('/') || propCanonicalUrl.includes('?') ? propCanonicalUrl : `${propCanonicalUrl}/`)
  : `https://screenshotchecker.com${normalizedPath}`;

// Ensure title tag strictly stays under 60 characters
const fullTitle =
  title.includes("Screenshot Checker") ||
  title.includes("ScreenshotChecker") ||
  title.length + siteName.length + 3 > 60
    ? title
    : `${title} | ${siteName}`;

const effectiveOgTitle = ogTitle || fullTitle;
const effectiveOgDescription = ogDescription || description;
// Per-page share image: public/og/<path-with-dashes>.png when it exists, else the site default.
const ogSlug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogImage = ogImageProp
  || (ogSlug && existsSync(join(process.cwd(), 'public', 'og', `${ogSlug}.png`)) ? `/og/${ogSlug}.png` : 'https://screenshotchecker.com/og-image.png');
const effectiveOgImage = ogImage.startsWith('http') ? ogImage : `https://screenshotchecker.com${ogImage.startsWith('/') ? ogImage : '/' + ogImage}`;

// Site-wide Organization JSON-LD Schema
const organizationSchema = {
  '@type': 'Organization',
  '@id': 'https://screenshotchecker.com/#organization',
  name: 'ScreenshotChecker',
  url: 'https://screenshotchecker.com/',
  logo: {
    '@type': 'ImageObject',
    '@id': 'https://screenshotchecker.com/#logo',
    url: 'https://screenshotchecker.com/web-app-manifest-512x512.png',
    caption: 'ScreenshotChecker',
  },
  sameAs: [
    'https://github.com/viratchauhan/screenshotchecker',
  ],
};

// Combine page structured data with site-wide Organization into @graph
let finalStructuredData: any = null;
if (structuredData) {
  if (Array.isArray(structuredData)) {
    finalStructuredData = {
      '@context': 'https://schema.org',
      '@graph': [...structuredData, organizationSchema],
    };
  } else if (typeof structuredData === 'object' && '@graph' in structuredData && Array.isArray((structuredData as any)['@graph'])) {
    const hasOrg = (structuredData as any)['@graph'].some((item: any) => item['@type'] === 'Organization');
    finalStructuredData = {
      '@context': 'https://schema.org',
      '@graph': hasOrg ? (structuredData as any)['@graph'] : [...(structuredData as any)['@graph'], organizationSchema],
    };
  } else if (typeof structuredData === 'object') {
    finalStructuredData = {
      '@context': 'https://schema.org',
      '@graph': [structuredData, organizationSchema],
    };
  }
} else {
  finalStructuredData = {
    '@context': 'https://schema.org',
    '@graph': [organizationSchema],
  };
}
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) - Non-blocking idle init -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      function initGtag() {
        if (window._gtagLoaded) return;
        window._gtagLoaded = true;
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KNZECVZEC0';
        document.head.appendChild(s);
        gtag('config', 'G-KNZECVZEC0');
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(initGtag, { timeout: 2500 });
      } else {
        window.addEventListener('load', () => setTimeout(initGtag, 800));
      }
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon & Web Manifest -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf9f5" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-Flash Theme Init Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('sc_theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="ScreenshotChecker" />
    <meta name="robots" content={robots} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={effectiveOgTitle} />
    <meta property="og:description" content={effectiveOgDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={effectiveOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={effectiveOgTitle} />
    <meta name="twitter:description" content={effectiveOgDescription} />
    <meta name="twitter:image" content={effectiveOgImage} />

    <!-- Google Fonts: Preconnect & Asynchronous Non-Blocking Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    {finalStructuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(finalStructuredData)} />
    )}

    {loadClarity && (
      <script is:inline define:vars={{ clarityId }}>
        (function (c, l, a, r, i) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          const start = () => {
            const t = l.createElement(r); t.async = true; t.src = 'https://www.clarity.ms/tag/' + i;
            const y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          };
          if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 4000 });
          else window.addEventListener('load', () => setTimeout(start, 1500));
        })(window, document, 'clarity', 'script', clarityId);
      </script>
    )}
  </head>
  <body class="bg-canvas text-body selection:bg-surface-cream-strong selection:text-ink min-h-screen flex flex-col">
    <slot />
    <script>
      import { bindGlobalAnalytics } from '../lib/utils/analytics';
      import { registerServiceWorker } from '../lib/utils/pwa';
      bindGlobalAnalytics();
      registerServiceWorker();
    </script>
  </body>
</html>
