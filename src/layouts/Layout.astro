---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  siteName?: string;
  structuredData?: object;
}

const {
  title = "Screenshot Checker – Analyze & Verify Screenshots Online",
  description = "Screenshot Checker is an online tool for analyzing screenshots and images for editing signals, visual inconsistencies, metadata, fraud indicators, and other digital evidence.",
  canonicalUrl = Astro.url.href.replace(/\/$/, '') ? (Astro.url.pathname === '/' ? 'https://screenshotchecker.com' : `https://screenshotchecker.com${Astro.url.pathname.replace(/\/$/, '')}/`) : 'https://screenshotchecker.com',
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage = "https://screenshotchecker.com/web-app-manifest-512x512.png",
  siteName = "ScreenshotChecker",
  structuredData,
} = Astro.props;

const fullTitle = title.includes("Screenshot Checker") || title.includes("ScreenshotChecker") ? title : `${title} | ${siteName}`;
const effectiveOgTitle = ogTitle || fullTitle;
const effectiveOgDescription = ogDescription || description;
const effectiveOgImage = ogImage.startsWith('http') ? ogImage : `https://screenshotchecker.com${ogImage.startsWith('/') ? ogImage : '/' + ogImage}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KNZECVZEC0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KNZECVZEC0');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon & Web Manifest -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-Flash Theme Init Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('sc_theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="ScreenshotChecker" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={effectiveOgTitle} />
    <meta property="og:description" content={effectiveOgDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={effectiveOgImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={effectiveOgTitle} />
    <meta name="twitter:description" content={effectiveOgDescription} />
    <meta name="twitter:image" content={effectiveOgImage} />

    <!-- Google Fonts: Cormorant Garamond (Serif), Inter (Sans), JetBrains Mono (Code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="bg-canvas text-body selection:bg-surface-cream-strong selection:text-ink min-h-screen flex flex-col">
    <slot />
  </body>
</html>
