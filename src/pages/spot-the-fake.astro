---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpotTheFakeQuiz from '../components/SpotTheFakeQuiz.astro';
import { QUIZ_ROUNDS, QUIZ_TIERS, QUIZ_UI_EN } from '../data/spotTheFake';

const canonicalUrl = 'https://screenshotchecker.com/spot-the-fake/';
const pageTitle = 'Spot the Fake Screenshot: Free Scam Quiz (10 Rounds)';
const pageDescription =
  'Can you tell a scam text, fake payment or edited chat from the real thing? Ten quick fictional rounds, an explanation after each, and a score to share.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://screenshotchecker.com/' },
        { '@type': 'ListItem', position: 2, name: 'Spot the Fake quiz', item: canonicalUrl },
      ],
    },
    {
      '@type': 'Quiz',
      '@id': `${canonicalUrl}#quiz`,
      name: 'Spot the Fake Screenshot',
      description: pageDescription,
      url: canonicalUrl,
      educationalLevel: 'Beginner',
      about: ['Phishing', 'Scam messages', 'Fake payment screenshots', 'Edited screenshots'],
      inLanguage: 'en',
      isAccessibleForFree: true,
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} structuredData={structuredData}>
  <link slot="head" rel="alternate" hreflang="en" href={canonicalUrl} />
  <link slot="head" rel="alternate" hreflang="hi" href="https://screenshotchecker.com/spot-the-fake/hindi/" />
  <Header currentPath="/spot-the-fake" />

  <main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <p class="text-center text-sm mb-4"><a href="/spot-the-fake/hindi/" lang="hi" class="text-primary underline">यह क्विज़ हिंदी में खेलें</a></p>
    <SpotTheFakeQuiz
      rounds={QUIZ_ROUNDS}
      tiers={QUIZ_TIERS}
      ui={QUIZ_UI_EN}
      shareUrl="https://screenshotchecker.com/spot-the-fake/?utm_source=quiz_share&utm_medium=social"
    >
      <p class="text-sm">More detail: <a href="/blog/smishing-fake-sms/" class="text-primary underline">fake SMS and WhatsApp messages</a>, <a href="/blog/fake-whatsapp-chat-screenshot/" class="text-primary underline">edited WhatsApp chats</a>, <a href="/blog/fake-upi-payment-screenshot/" class="text-primary underline">fake UPI payments</a> and <a href="/blog/fake-payment-screenshot-paypal-venmo-cash-app/" class="text-primary underline">PayPal, Venmo and Cash App scams</a>.</p>
    </SpotTheFakeQuiz>
  </main>

  <Footer />
</Layout>
