---
import PaymentToolLayout from '../../components/PaymentToolLayout.astro';
import { PAYMENT_COPY_HI } from '../../data/paymentToolCopy';

const alternates = [
  { hreflang: 'en', href: 'https://screenshotchecker.com/payment-screenshot-checker/' },
  { hreflang: 'hi', href: 'https://screenshotchecker.com/payment-screenshot-checker/hindi/' },
  { hreflang: 'x-default', href: 'https://screenshotchecker.com/payment-screenshot-checker/' },
];

const props = {
  lang: 'hi' as const,
  copy: PAYMENT_COPY_HI,
  alternates,
  title: 'नकली पेमेंट स्क्रीनशॉट चेकर: UPI, PhonePe, GPay',
  metaDescription:
    'ग्राहक ने UPI पेमेंट का स्क्रीनशॉट भेजा? PhonePe, Google Pay, Paytm रसीद का टेक्स्ट मुफ़्त में जांचें, फिर पैसा अपने बैंक या UPI ऐप में ही पक्का करें।',
  badge: 'नकली UPI स्क्रीनशॉट चेकर',
  heading: 'नकली UPI पेमेंट स्क्रीनशॉट चेकर',
  subheading:
    'पेमेंट स्क्रीनशॉट का टेक्स्ट पढ़कर रकम और reference के नियम जांचें। यह टूल यह साबित नहीं कर सकता कि तस्वीर असली है या पैसा आपके खाते में आ गया है।',
  howItWorksSteps: [
    { step: '1', title: 'स्क्रीनशॉट अपलोड करें', desc: 'पेमेंट स्क्रीनशॉट अपलोड या paste करें। जितना साफ़ टेक्स्ट होगा, OCR उतना बेहतर पढ़ेगा।' },
    { step: '2', title: 'रसीद का टेक्स्ट पढ़ें', desc: 'OCR रकम, reference, तारीख और पाने वाले का नाम पढ़ने की कोशिश करता है। पढ़ी गई जानकारी को मूल तस्वीर से मिलाएं।' },
    { step: '3', title: 'नियमों से जांच', desc: 'टूल टेक्स्ट को पहचानकर तय नियम लगाता है। फ़ॉन्ट, आइकन की जगह और लेआउट नहीं मापे जाते।' },
    { step: '4', title: 'अपने खाते में पैसा देखें', desc: 'अपने बैंक या UPI ऐप में वही पेमेंट खोजें। टूल का कोई भी नतीजा पैसा मिलने की पुष्टि नहीं करता।' },
  ],
  examples: [
    { title: 'Google Pay (GPay) रसीद', desc: 'रकम, पाने वाले का नाम और reference पढ़े जाते हैं। Google Pay का नाम टेक्स्ट से पहचाना जाता है, ऐप से इसकी पुष्टि नहीं होती।' },
    { title: 'PhonePe पेमेंट स्लिप', desc: 'पढ़ी गई जानकारी और नियमों की चेतावनियां देखें। OCR के लेबल या निशान फ़ॉन्ट की गड़बड़ी या गलत आइकन साबित नहीं करते।' },
    { title: 'Paytm, BHIM और Pop UPI रसीद', desc: 'इन ऐप के नाम टेक्स्ट में पहचाने जा सकते हैं। अधूरी, अनजानी या गलत पढ़ी गई जानकारी से पहचान अधूरी या गलत हो सकती है।' },
  ],
  limitations: [
    'यह टूल OCR और टेक्स्ट के नियमों से जांच करता है। यह फ़ॉन्ट, आइकन की जगह, लोगो या पिक्सल एडिटिंग नहीं मापता, और आपके बैंक से संपर्क नहीं करता।',
    'Risk score और लेबल धोखे की प्रतिशत संभावना नहीं हैं। LOW RISK का मतलब असली नहीं, और चेतावनी OCR की गलती या मामूली अंतर से भी आ सकती है।',
    'Payment Proof Strength सिर्फ़ यह बताता है कि रसीद के कितने हिस्से पहचाने गए। STRONG VISUAL भी यह साबित नहीं करता कि पैसा आपको मिल गया।',
    'सामान, सेवा या refund देने से पहले अपने बैंक या UPI ऐप में आई रकम पक्की करें। सिर्फ़ स्क्रीनशॉट, SMS या soundbox की आवाज़ काफ़ी नहीं है।',
  ],
  faqs: [
    {
      question: 'नकली UPI स्क्रीनशॉट चेकर क्या है?',
      answer: 'यह टूल OCR से रसीद का टेक्स्ट पढ़ता है, स्क्रीन को पहचानकर पेमेंट की जानकारी निकालता है और फिर तय नियम लगाता है। यह फ़ॉन्ट, आइकन या लेआउट नहीं मापता, ऐप की पुष्टि नहीं करता और बैंक से लेन-देन नहीं जांचता।',
    },
    {
      question: 'क्या यह नकली PhonePe स्क्रीनशॉट पकड़ सकता है?',
      answer: 'यह PhonePe स्क्रीनशॉट में नियमों से मेल खाती बातें दिखा सकता है, लेकिन पक्के तौर पर नहीं बता सकता कि तस्वीर नकली है। मूल तस्वीर देखें और पेमेंट अपने ऐप में पक्का करें।',
    },
    {
      question: 'क्या स्क्रीनशॉट से साबित होता है कि मुझे पैसा मिल गया?',
      answer: 'नहीं। अपने बैंक या UPI ऐप में आई रकम ही सबूत है। अच्छा दिखने वाला स्क्रीनशॉट, सही लगने वाला reference या STRONG VISUAL लेबल पैसा मिलने का सबूत नहीं है।',
    },
    {
      question: 'स्क्रीनशॉट असली लगे पर पैसा न आए तो क्या करें?',
      answer: 'पेमेंट को अभी पक्का न मानें। सामान या refund रोकें, अपने ऐप में transaction status देखें और ज़रूरत हो तो बैंक या ऐप के आधिकारिक Help से संपर्क करें। पेमेंट अटकना या गलत खाते में जाना भी हो सकता है, इसका मतलब हमेशा नकली स्क्रीनशॉट नहीं होता।',
    },
    {
      question: 'नकली पेमेंट स्क्रीनशॉट के आम संकेत क्या हैं?',
      answer: 'रकम में मेल न होना, अजीब reference या पेमेंट के बजाय कोई और स्क्रीन, ये दोबारा देखने की वजह हैं, धोखे का सबूत नहीं। OCR अंक गलत पढ़ सकता है, फ़ीस या बैलेंस रकम से अलग हो सकता है। सिर्फ़ SMS या soundbox की आवाज़ न आना नकली स्क्रीनशॉट का सबूत नहीं है।',
    },
    {
      question: 'क्या यह टूल 100% सही है?',
      answer: 'नहीं। यह कुछ गड़बड़ियां छोड़ सकता है और कभी सही चीज़ पर भी चेतावनी दे सकता है। Score सटीकता या धोखे की संभावना नहीं है, और अधूरी जांच को साफ़ नतीजा न मानें। पेमेंट हमेशा अपने बैंक या UPI ऐप में पक्का करें।',
    },
  ],
};
---

<PaymentToolLayout {...props} />
