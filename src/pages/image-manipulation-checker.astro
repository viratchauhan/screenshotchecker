---
import Layout from '../layouts/Layout.astro';
import ForensicsWorkspace from '../components/workspaces/ForensicsWorkspace.astro';
import { getToolFaqs } from '../data/toolFaqs';

const canonicalUrl = 'https://screenshotchecker.com/image-manipulation-checker/';
const pageTitle = 'Screenshot Forensics & ELA Manipulation Checker';
const pageDescription =
  'Spot edited screenshots with Error Level Analysis (ELA) and clone detection. 100% free, private in-browser image forensics.';

const faqs = getToolFaqs('image-manipulation-checker');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#webapp`,
      name: 'Screenshot Forensics & ELA Manipulation Checker',
      url: canonicalUrl,
      description: pageDescription,
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Any (Browser-based)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://screenshotchecker.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: 'https://screenshotchecker.com/tools/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Image Forensics',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={structuredData}
>
  <ForensicsWorkspace />
</Layout>
