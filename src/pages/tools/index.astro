---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { TOOLS_REGISTRY, TOOL_CATEGORIES } from '../../data/tools';

const featuredTool = TOOLS_REGISTRY.find((t) => t.isFeatured) || TOOLS_REGISTRY[0];
const popularTools = TOOLS_REGISTRY.filter((t) => t.isPopular && !t.isFeatured);

const canonicalUrl = 'https://screenshotchecker.com/tools/';
const pageTitle = 'Free Screenshot Analysis Tools – Forensics & OCR';
const pageDescription =
  'Explore 12+ free browser tools for screenshot forensics, payment slip verification, OCR extraction, metadata cleaning, and redaction.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://screenshotchecker.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={structuredData}
>
  <Header currentPath="/tools" />

  <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-card border border-hairline text-ink text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        <span>Toolkit Directory</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-normal text-ink tracking-tight mb-4">
        Explore Tools to Understand, Protect & Transform Images
      </h1>
      <p class="text-sm sm:text-base text-body leading-relaxed max-w-2xl mx-auto">
        Privacy-first client-side image utilities for visual intelligence, OCR extraction, PII redaction, metadata inspection, and forensic analysis.
      </p>
    </div>

    <!-- Client-Side Search Input -->
    <div class="max-w-xl mx-auto mb-12">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="tools-search-input"
          placeholder="Search by tool name, alias (e.g. 'remove GPS', 'hide phone'), or task..."
          class="w-full pl-10 pr-4 py-3 bg-canvas border border-hairline rounded-xl text-sm text-ink placeholder:text-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all shadow-sm"
        />
        <span id="search-result-count" class="hidden absolute right-3 top-3 text-[11px] font-mono text-muted bg-surface-card px-2 py-0.5 rounded border border-hairline">
          0 found
        </span>
      </div>
    </div>

    <!-- Search Results Dynamic Container (Hidden by default) -->
    <div id="search-results-section" class="hidden mb-16">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-serif text-2xl text-ink font-normal">Search Results</h2>
        <button id="clear-search-btn" class="text-xs text-primary hover:underline">Clear search</button>
      </div>
      <div id="search-results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Rendered via JS -->
      </div>
    </div>

    <!-- Default Directory View (Featured + Popular + Categories) -->
    <div id="default-directory-content" class="space-y-16">
      <!-- Featured Tool Highlight -->
      {featuredTool && (
        <section class="bg-surface-cream-strong/40 border border-primary/25 rounded-2xl p-6 sm:p-8 relative overflow-hidden">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="max-w-2xl space-y-3">
              <div class="flex items-center gap-2">
                <span class="badge-pill !bg-primary !text-on-primary !border-none text-[10px] uppercase font-bold tracking-wider">
                  Featured Tool
                </span>
                <span class="text-xs text-muted font-mono">{featuredTool.category}</span>
              </div>
              <h2 class="font-serif text-2xl sm:text-3xl text-ink font-normal">
                {featuredTool.name}
              </h2>
              <p class="text-sm text-body leading-relaxed">
                {featuredTool.description} Our primary visual investigator that reasons over text, claims, payment directives, and risks.
              </p>
            </div>
            <a href={featuredTool.route} class="btn-primary shrink-0 self-start lg:self-center">
              <span>Open Workspace</span>
              <span>→</span>
            </a>
          </div>
        </section>
      )}

      <!-- Popular Tools Grid -->
      <section>
        <div class="flex items-center justify-between mb-6 pb-2 border-b border-hairline">
          <h2 class="font-serif text-2xl text-ink font-normal">Popular Tools</h2>
          <span class="text-xs text-muted">Essential Workspaces</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {popularTools.map((tool) => (
            <a
              href={tool.route}
              class="feature-card group flex flex-col justify-between hover:border-primary/50 transition-all text-left"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-xs font-semibold text-muted font-mono uppercase tracking-wider">
                    {tool.category}
                  </span>
                  {tool.badge && (
                    <span class="badge-pill !text-[10px]">
                      {tool.badge}
                    </span>
                  )}
                </div>
                <h3 class="font-serif text-xl text-ink font-normal group-hover:text-primary transition-colors mb-2">
                  {tool.name}
                </h3>
                <p class="text-xs sm:text-sm text-body leading-relaxed">
                  {tool.description}
                </p>
              </div>
              <div class="mt-5 pt-3 border-t border-hairline flex items-center justify-between text-xs text-muted group-hover:text-primary transition-colors">
                <span class="font-medium">Open tool</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Categorized Full Directory -->
      <section class="space-y-12">
        <div class="flex items-center justify-between pb-2 border-b border-hairline">
          <h2 class="font-serif text-2xl text-ink font-normal">All Tools by Category</h2>
          <span class="text-xs text-muted">{TOOLS_REGISTRY.length} Tools Available</span>
        </div>

        {TOOL_CATEGORIES.map((category) => {
          const categoryTools = TOOLS_REGISTRY.filter((t) => t.category === category);
          if (categoryTools.length === 0) return null;
          return (
            <div class="space-y-4">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <h3 class="font-serif text-xl text-ink font-normal">{category}</h3>
                <span class="text-xs text-muted font-mono">({categoryTools.length})</span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {categoryTools.map((tool) => (
                  <a
                    href={tool.route}
                    class="bg-canvas border border-hairline rounded-xl p-4 hover:border-primary/40 hover:bg-surface-card transition-all group flex flex-col justify-between"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-1 mb-1.5">
                        <span class="text-sm font-semibold text-ink group-hover:text-primary transition-colors">
                          {tool.name}
                        </span>
                        {tool.badge && (
                          <span class="badge-pill !text-[9px]">
                            {tool.badge}
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-muted leading-relaxed line-clamp-2">
                        {tool.description}
                      </p>
                    </div>
                    <div class="mt-4 pt-2 border-t border-hairline/60 flex items-center justify-end text-[11px] text-muted group-hover:text-primary font-medium">
                      <span>Launch workspace →</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { TOOLS_REGISTRY } from '../../data/tools';

  function setupToolSearch() {
    const input = document.getElementById('tools-search-input') as HTMLInputElement | null;
    const defaultContent = document.getElementById('default-directory-content');
    const searchSection = document.getElementById('search-results-section');
    const searchGrid = document.getElementById('search-results-grid');
    const countBadge = document.getElementById('search-result-count');
    const clearBtn = document.getElementById('clear-search-btn');

    function executeSearch(query: string) {
      const q = query.trim().toLowerCase();
      if (!q) {
        defaultContent?.classList.remove('hidden');
        searchSection?.classList.add('hidden');
        countBadge?.classList.add('hidden');
        return;
      }

      const matches = TOOLS_REGISTRY.filter((tool) => {
        if (tool.name.toLowerCase().includes(q)) return true;
        if (tool.description.toLowerCase().includes(q)) return true;
        if (tool.category.toLowerCase().includes(q)) return true;
        if (tool.keywords.some((k) => k.toLowerCase().includes(q))) return true;
        if (tool.aliases.some((a) => a.toLowerCase().includes(q))) return true;
        return false;
      });

      defaultContent?.classList.add('hidden');
      searchSection?.classList.remove('hidden');

      if (countBadge) {
        countBadge.innerText = `${matches.length} found`;
        countBadge.classList.remove('hidden');
      }

      if (searchGrid) {
        if (matches.length === 0) {
          searchGrid.innerHTML = `
            <div class="col-span-full text-center py-12 bg-canvas border border-hairline rounded-xl">
              <p class="text-sm text-body">No tools found matching "${query}".</p>
              <p class="text-xs text-muted mt-1">Try searching for keywords like "OCR", "redact", "metadata", or "compare".</p>
            </div>
          `;
        } else {
          searchGrid.innerHTML = matches
            .map(
              (tool) => `
            <a href="${tool.route}" class="feature-card group flex flex-col justify-between hover:border-primary/50 transition-all text-left">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-[10px] font-mono text-muted uppercase tracking-wider">${tool.category}</span>
                  ${tool.badge ? `<span class="badge-pill !text-[9px]">${tool.badge}</span>` : ''}
                </div>
                <h3 class="font-serif text-lg text-ink font-normal group-hover:text-primary transition-colors mb-1.5">${tool.name}</h3>
                <p class="text-xs text-body leading-relaxed">${tool.description}</p>
              </div>
              <div class="mt-4 pt-2 border-t border-hairline flex items-center justify-between text-xs text-muted group-hover:text-primary">
                <span>Open Workspace</span>
                <span>→</span>
              </div>
            </a>
          `
            )
            .join('');
        }
      }
    }

    input?.addEventListener('input', (e) => {
      executeSearch((e.target as HTMLInputElement).value);
    });

    clearBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      executeSearch('');
    });
  }

  setupToolSearch();
  document.addEventListener('astro:page-load', setupToolSearch);
</script>
