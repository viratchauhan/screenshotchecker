---
import Layout from '../layouts/Layout.astro';
import ComparisonWorkspace from '../components/workspaces/ComparisonWorkspace.astro';
import { getToolFaqs } from '../data/toolFaqs';

const canonicalUrl = 'https://screenshotchecker.com/screenshot-comparison/';
const pageTitle = 'Screenshot Comparison Tool – Visual Image Diff';
const pageDescription =
  'Compare two screenshots side-by-side with slider overlays and diff heatmaps. Find visual differences fast, free, in-browser.';

const faqs = getToolFaqs('screenshot-comparison');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#webapp`,
      name: 'Screenshot Comparison Tool',
      url: canonicalUrl,
      description: pageDescription,
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Any (Browser-based)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://screenshotchecker.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: 'https://screenshotchecker.com/tools/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Screenshot Comparison',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={structuredData}
>
  <ComparisonWorkspace />
</Layout>
