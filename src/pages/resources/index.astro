---
import { getArticleBySlug } from '../../data/blogArticles';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

const currentPath = '/resources/';
const canonicalUrl = 'https://screenshotchecker.com/resources/';
const pageTitle = 'Screenshot Security & Forensics Resources';
const pageDescription =
  'Step-by-step security tutorials on safe screenshot sharing, removing GPS metadata, detecting smishing, and running ELA forensics.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://screenshotchecker.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Resources',
          item: canonicalUrl,
        },
      ],
    },
  ],
};

// Real guides, pulled from the blog data so titles, summaries and read times stay accurate.
const guides = [
  'redact-screenshot-before-sharing',
  'exif-metadata',
  'smishing-fake-sms',
  'screenshot-checker-online',
  'how-to-tell-if-a-photo-is-edited',
  'ai-image-detector-online',
]
  .map((slug) => getArticleBySlug(slug))
  .filter((article): article is NonNullable<typeof article> => Boolean(article));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={structuredData}
>
  <Header currentPath={currentPath} />

  <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-14 text-center max-w-2xl mx-auto">
      <span class="badge-coral text-xs mb-3 inline-block">Knowledge Base</span>
      <h1 class="font-serif text-3xl sm:text-5xl font-normal text-ink mb-4">
        Screenshot Safety & Privacy Guides
      </h1>
      <p class="text-sm sm:text-base text-muted">
        Practical tutorials, security explanations, and best practices for auditing and protecting digital images.
      </p>
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {guides.map((guide) => (
        <article class="feature-card !p-6 flex flex-col justify-between hover:border-primary/40 transition-colors">
          <div>
            <div class="flex items-center justify-between text-xs text-muted mb-3">
              <span class="badge-pill !text-[11px] !py-0.5">{guide.category}</span>
              <span>{guide.readTime}</span>
            </div>
            <h2 class="font-serif text-xl text-ink font-normal mb-2.5 leading-snug">
              <a href={`/blog/${guide.slug}/`} class="hover:text-primary transition-colors">{guide.title}</a>
            </h2>
            <p class="text-xs sm:text-sm text-body leading-relaxed">
              {guide.excerpt}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-hairline flex items-center justify-between">
            <a href={`/blog/${guide.slug}/`} class="text-xs font-medium text-primary hover:text-primary-active inline-flex items-center gap-1">
              <span>Read the guide</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <RelatedLinks currentPath={currentPath} />
  </main>

  <Footer />
</Layout>
