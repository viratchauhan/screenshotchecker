---
import Layout from '../layouts/Layout.astro';
import MetadataWorkspace from '../components/workspaces/MetadataWorkspace.astro';
import { getToolFaqs } from '../data/toolFaqs';

const canonicalUrl = 'https://screenshotchecker.com/screenshot-metadata-checker/';
const pageTitle = 'Screenshot Metadata Checker – View EXIF & GPS';
const pageDescription =
  'Uncover hidden EXIF data, GPS location coordinates, camera models, and edit history from images. Free, private, client-side.';

const faqs = getToolFaqs('screenshot-metadata-checker');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#webapp`,
      name: 'Screenshot Metadata Checker',
      url: canonicalUrl,
      description: pageDescription,
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Any (Browser-based)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://screenshotchecker.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: 'https://screenshotchecker.com/tools/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Metadata Checker',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={structuredData}
>
  <MetadataWorkspace currentPath="/screenshot-metadata-checker" />
</Layout>
