---
import Layout from '../layouts/Layout.astro';
import LinkCheckerWorkspace from '../components/workspaces/LinkCheckerWorkspace.astro';
import { getToolFaqs } from '../data/toolFaqs';

const canonicalUrl = 'https://screenshotchecker.com/suspicious-link-checker/';
const pageTitle = 'Suspicious Link Checker – Scan Screenshot URLs';
const pageDescription =
  'Worried about a link in a screenshot? Extract and check URLs for phishing, spoofing, and malicious redirects completely free.';

const faqs = getToolFaqs('suspicious-link-checker');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#webapp`,
      name: 'Suspicious Link Checker',
      url: canonicalUrl,
      description: pageDescription,
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Any (Browser-based)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://screenshotchecker.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: 'https://screenshotchecker.com/tools/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Suspicious Link Checker',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={structuredData}
>
  <LinkCheckerWorkspace />
</Layout>
