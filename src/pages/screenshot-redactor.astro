---
import Layout from '../layouts/Layout.astro';
import RedactorWorkspace from '../components/workspaces/RedactorWorkspace.astro';
import { getToolFaqs } from '../data/toolFaqs';

const canonicalUrl = 'https://screenshotchecker.com/screenshot-redactor/';
const pageTitle = 'Screenshot Redactor – Blur & Hide Sensitive Info';
const pageDescription =
  'Blur, pixelate, or black out sensitive info before sharing screenshots. Instant, zero-upload redaction right in your browser.';

const faqs = getToolFaqs('screenshot-redactor');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#webapp`,
      name: 'Screenshot Redactor',
      url: canonicalUrl,
      description: pageDescription,
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Any (Browser-based)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://screenshotchecker.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: 'https://screenshotchecker.com/tools/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Screenshot Redactor',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={structuredData}
>
  <RedactorWorkspace currentPath="/screenshot-redactor" />
</Layout>
