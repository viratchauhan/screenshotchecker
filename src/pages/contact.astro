---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://screenshotchecker.com/contact/';
const pageTitle = 'Contact Us – ScreenshotChecker Support';
const pageDescription =
  'Have questions or feedback about ScreenshotChecker? Contact our team for assistance with in-browser image analysis and privacy tools.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://screenshotchecker.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Contact',
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={structuredData}
>
  <Header currentPath="/contact" />

  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <!-- Hero / Title -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs uppercase tracking-wider font-semibold text-primary font-mono block mb-2">Get In Touch</span>
      <h1 class="font-serif text-3xl sm:text-5xl font-normal text-ink tracking-tight mb-4">
        Contact Us
      </h1>
      <p class="text-base text-body leading-relaxed">
        Have questions, feedback, feature requests, or security inquiries? Reach out directly via email or LinkedIn.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="max-w-xl mx-auto space-y-6">
      <!-- Email Card -->
      <a
        href="mailto:virat@screenshotchecker.com"
        class="block p-6 sm:p-8 bg-canvas border border-hairline hover:border-primary/40 rounded-2xl transition-all shadow-sm hover:shadow-md group"
      >
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-surface-cream-strong flex items-center justify-center text-primary shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </div>
          <div class="space-y-1">
            <span class="text-xs font-mono font-medium text-primary uppercase tracking-wider block">Email Address</span>
            <div class="font-serif text-xl sm:text-2xl text-ink group-hover:text-primary transition-colors">
              virat@screenshotchecker.com
            </div>
            <p class="text-xs text-body-soft pt-1">
              Click to send an email directly. Typical response within 24 hours.
            </p>
          </div>
        </div>
      </a>

      <!-- LinkedIn Card -->
      <a
        href="https://www.linkedin.com/in/viratchauhan1/"
        target="_blank"
        rel="noopener noreferrer"
        class="block p-6 sm:p-8 bg-canvas border border-hairline hover:border-primary/40 rounded-2xl transition-all shadow-sm hover:shadow-md group"
      >
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-surface-cream-strong flex items-center justify-center text-primary shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect width="4" height="12" x="2" y="9" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          </div>
          <div class="space-y-1">
            <span class="text-xs font-mono font-medium text-primary uppercase tracking-wider block">LinkedIn Profile</span>
            <div class="font-serif text-xl sm:text-2xl text-ink group-hover:text-primary transition-colors flex items-center gap-1.5">
              <span>Virat Chauhan</span>
              <span class="text-xs font-sans text-body-soft">↗</span>
            </div>
            <p class="text-xs text-body-soft pt-1">
              Connect on LinkedIn for networking, collaboration, and updates.
            </p>
          </div>
        </div>
      </a>

      <!-- Privacy & Response Note -->
      <div class="p-5 bg-canvas border border-hairline/60 rounded-xl text-center text-xs text-body-soft leading-relaxed">
        ScreenshotChecker is an independent, privacy-first image intelligence platform. All analysis runs 100% locally in your browser.
      </div>
    </div>
  </main>

  <Footer />
</Layout>
