{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenshotchecker",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "screenshotchecker.com", "custom_domain": true },
    { "pattern": "www.screenshotchecker.com", "custom_domain": true }
  ]
}
